# Example environment for the Vibe Coded Emulator web app.
# Copy to a real environment file and fill in your own values. Never commit
# real secrets. All fields are optional unless noted.

# --- Core -------------------------------------------------------------------
# "development", "staging" or "production". Staging-only features (controller,
# multiplayer rooms, sync) are disabled in production.
AN3_ENVIRONMENT=development
# Where the SQLite database, ROMs and uploads live.
AN3_DATA_DIR=./data
# HTTP listener.
AN3_HOST=0.0.0.0
AN3_PORT=8091
# Public base URL, used for links and cookie security decisions.
AN3_BASE_URL=http://127.0.0.1:8091
# Set to 1 when served over HTTPS so cookies are marked Secure.
AN3_COOKIE_SECURE=0

# --- First administrator (required only for the first start) ----------------
AN3_ADMIN_NAME=admin
AN3_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# --- Sessions ---------------------------------------------------------------
# Random secret used to salt password/session hashing. Generate your own:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AN3_AUTH_PEPPER=YOUR_RANDOM_PEPPER

# --- Contact shown on the site (optional) -----------------------------------
AN3_MAINTAINER_EMAIL=

# --- EmulatorJS netplay relay (staging only) --------------------------------
# Separate Socket.IO relay origin. Leave empty to disable netplay/rooms.
AN3_NETPLAY_ORIGIN=

# --- Google sign-in / Drive sync (optional) ---------------------------------
# Create your own OAuth client in Google Cloud Console, enable the Drive API,
# and add the redirect URI <AN3_BASE_URL>/api/sync/google/callback.
# Scopes: openid, email, profile, https://www.googleapis.com/auth/drive.appdata
AN3_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
AN3_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# --- Native player (optional) -----------------------------------------------
# Directory that contains a "libretro" folder with the emulator cores.
# AN3_OFFLINE_LIBDIR=/path/to/runtime/linux-x86_64
# Public source repository URL shown on the Licenses page.
AN3_SOURCE_REPOSITORY=https://github.com/YOUR_GITHUB_USER/vibe-coded-emulator
