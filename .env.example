# AN3 Arcade / Vibe Coded Emulator — environment template
#
# Copy to `.env` (never committed) and fill in real values. Every value below is
# a placeholder; none is a secret from any deployment. Public source contains no
# credentials by design — all secrets come from the runtime environment.

# --- Core server -------------------------------------------------------------
AN3_ENVIRONMENT=development
AN3_HOST=127.0.0.1
AN3_PORT=8092
AN3_BASE_URL=http://127.0.0.1:8092
AN3_DATA_DIR=./data
AN3_APP_DIR=.
AN3_BUILD_ID=
AN3_COOKIE_SECURE=false

# --- Auth / admin ------------------------------------------------------------
# Set a long random value at deploy time. Do not commit a real one.
AN3_AUTH_PEPPER=generate-a-long-random-secret
# Create the first admin only through a private, one-off bootstrap. Never ship
# default credentials.
AN3_ADMIN_NAME=
AN3_ADMIN_PASSWORD=

# --- ROM library limits ------------------------------------------------------
AN3_MAX_ROM_BYTES=268435456
AN3_UPLOAD_CHUNK_BYTES=1048576

# --- Bug reports / GitHub issue bridge (server-side only) --------------------
# The GitHub token is a server secret. It is NEVER sent to, stored in, or read
# by any client, and it must not be committed. Leave empty to disable issue
# creation (reports are still persisted).
AN3_BUG_REPORTS_ENABLED=false
AN3_GITHUB_ISSUES_TOKEN=
AN3_GITHUB_REPOSITORY=
AN3_GITHUB_API_BASE=https://api.github.com
AN3_GITHUB_ISSUE_LABELS=

# --- Netplay / multiplayer (LAN relay) --------------------------------------
AN3_NETPLAY_ORIGIN=http://127.0.0.1:8094

# --- Diagnostics -------------------------------------------------------------
AN3_TURBOSTAT_HELPER=
AN3_MAINTAINER_EMAIL=YOUR_EMAIL@example.com

# --- Public source (used to satisfy corresponding-source references) ---------
AN3_SOURCE_REPOSITORY=https://github.com/YOUR_GITHUB_USER/an3-arcade

# --- Google Sync (out of scope; leave disabled) ------------------------------
AN3_GOOGLE_CLIENT_ID=
