{
  "skillVersion": "1.1.0",
  "manifestSchemaVersion": 1,
  "workerStatusSchemaVersion": 1,
  "provenanceSchemaVersion": 1,
  "model": "opencode-go/deepseek-v4.1-flash",
  "modelProvider": "opencode-go",
  "concurrency": {
    "orchestrator": 1,
    "topLevelSessions": 5,
    "subagentsPerSession": 3,
    "platformTestersPerResource": 1
  },
  "backlog": {
    "readyForReview": 3,
    "qaQueue": 3,
    "integrationQueue": 3
  },
  "worktree": {
    "root": "..",
    "prefix": "an3-wt",
    "agentBranchPrefix": "agent",
    "integrationBranchPrefix": "integration",
    "promotionBranchPrefix": "promotion",
    "qaBranchPrefix": "agent"
  },
  "stateDir": "opencode-orchestrator",
  "sessions": {
    "binary": "opencode",
    "reportFormat": "json",
    "defaultAgent": "an3-worker",
    "orchestratorAgent": "an3-orchestrator",
    "integratorAgent": "an3-integrator"
  },
  "sessionStates": [
    "PROCESS_RUNNING",
    "SESSION_RESUMABLE",
    "SESSION_UNKNOWN",
    "SESSION_DEAD"
  ],
  "candidateStages": [
    "WORKING",
    "READY_FOR_REVIEW",
    "IN_QA",
    "REVIEWED",
    "INTEGRATED",
    "REJECTED",
    "BLOCKED"
  ],
  "integrationMethods": ["cherry-pick", "merge", "adapted", "already-integrated"],
  "resources": [
    "android-avd:codex-nds-api35",
    "android-avd:an3qa-api35",
    "windows-vm:an3-win11-build",
    "linux-builder:an3-dell",
    "staging:8092",
    "port-range:8110-8119",
    "port-range:8130-8139",
    "port-range:8140-8149",
    "port-range:8150-8159",
    "artifact-dir:native-offline/releases"
  ],
  "centralContracts": [
    "app.py",
    "netcode.py",
    "sync_engine.py",
    "native-offline/package.json",
    "native-offline/package-lock.json",
    "native-offline/src-tauri/Cargo.toml",
    "native-offline/src-tauri/Cargo.lock",
    "native-offline/src-tauri/build.rs",
    "native-offline/src-tauri/src/lib.rs",
    "native-offline/shared/*.json",
    "native-offline/releases/catalog.json",
    "static/player.js",
    "static/nds-touch.js",
    "static/site.css",
    "static/renderer-worker.js"
  ],
  "knownAcceptedWarnings": {
    "duplicate-rg": {
      "ids": ["RG-057", "RG-060", "RG-062", "RG-063", "RG-064"],
      "justification": "docs/REGRESSION_GUARDS.md keeps layered 'Previous authority' / 'Current authority' sections that intentionally reuse these numbers for different historical guards; the ids are referenced across docs and tests, so renumbering would corrupt the historical record. New duplicates still FAIL (base-relative); these are accepted known history."
    },
    "stale-release-filenames": {
      "ids": [],
      "justification": "No accepted entries. tools/release-train.sh must derive artifact names from the version metadata; a hard-coded semver literal is FAIL."
    }
  },
  "statuses": {
    "worker": ["WORKING", "READY_FOR_REVIEW", "NEEDS_FIX", "BLOCKED", "FAILED"],
    "dimensions": [
      "IMPLEMENTATION",
      "QA",
      "INTEGRATION",
      "CROSS_PLATFORM",
      "STAGING",
      "PROMOTION"
    ],
    "overall": [
      "COMPLETE",
      "PARTIAL_VERIFIED",
      "BLOCKED",
      "FAILED",
      "CANCELLED"
    ]
  }
}
