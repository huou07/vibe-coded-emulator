+// Refer to the license.txt file included.
+
+// ARM Multiply handlers: Mul, MulS, Mla, MlaS, Umull, UmullS, Umlal, UmlalS,
+//     Smull, SmullS, Smlal, SmlalS, and the halfword forms Smulxy, Smlaxy,
+//     Smulwy, Smlawy, Smlalxy
+
+handle_Mul: {
+    CHECK_COND();
+    u32 result = state_.regs[inst->mul.rm] * state_.regs[inst->mul.rs];
+    state_.regs[inst->rd] = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_MulS: {
+    CHECK_COND();
+    u32 result = state_.regs[inst->mul.rm] * state_.regs[inst->mul.rs];
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.Materialize();
+    state_.lazy_flags.op = FlagOp::Mul;
+    state_.lazy_flags.result = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Mla: {
+    CHECK_COND();
+    u32 result = state_.regs[inst->mul.rm] * state_.regs[inst->mul.rs] + state_.regs[inst->mul.rn];
+    state_.regs[inst->rd] = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_MlaS: {
+    CHECK_COND();
+    u32 result = state_.regs[inst->mul.rm] * state_.regs[inst->mul.rs] + state_.regs[inst->mul.rn];
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.Materialize();
+    state_.lazy_flags.op = FlagOp::Mul;
+    state_.lazy_flags.result = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Umull: {
+    CHECK_COND();
+    u64 result = static_cast<u64>(state_.regs[inst->mul.rm]) * state_.regs[inst->mul.rs];
+    state_.regs[inst->rd] = static_cast<u32>(result);
+    state_.regs[inst->mul.rdhi] = static_cast<u32>(result >> 32);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_UmullS: {
+    CHECK_COND();
+    u64 result = static_cast<u64>(state_.regs[inst->mul.rm]) * state_.regs[inst->mul.rs];
+    state_.regs[inst->rd] = static_cast<u32>(result);
+    state_.regs[inst->mul.rdhi] = static_cast<u32>(result >> 32);
+    state_.lazy_flags.Materialize();
+    state_.lazy_flags.op = FlagOp::Mul;
+    // N = bit 63; Z = the whole 64-bit result == 0. Folding "low word nonzero"
+    // into bit 0 lets one u32 carry both (bit 31 keeps N, zero iff u64 was 0).
+    state_.lazy_flags.result =
+        static_cast<u32>(static_cast<u64>(result) >> 32) | (static_cast<u32>(result) ? 1u : 0u);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Umlal: {
+    CHECK_COND();
+    u64 accum = (static_cast<u64>(state_.regs[inst->mul.rdhi]) << 32) | state_.regs[inst->rd];
+    u64 result = static_cast<u64>(state_.regs[inst->mul.rm]) * state_.regs[inst->mul.rs] + accum;
+    state_.regs[inst->rd] = static_cast<u32>(result);
+    state_.regs[inst->mul.rdhi] = static_cast<u32>(result >> 32);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_UmlalS: {
+    CHECK_COND();
+    u64 accum = (static_cast<u64>(state_.regs[inst->mul.rdhi]) << 32) | state_.regs[inst->rd];
+    u64 result = static_cast<u64>(state_.regs[inst->mul.rm]) * state_.regs[inst->mul.rs] + accum;
+    state_.regs[inst->rd] = static_cast<u32>(result);
+    state_.regs[inst->mul.rdhi] = static_cast<u32>(result >> 32);
+    state_.lazy_flags.Materialize();
+    state_.lazy_flags.op = FlagOp::Mul;
+    // 64-bit N/Z packing, as in UmullS
+    state_.lazy_flags.result =
+        static_cast<u32>(static_cast<u64>(result) >> 32) | (static_cast<u32>(result) ? 1u : 0u);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Smull: {
+    CHECK_COND();
+    s64 result = static_cast<s64>(static_cast<s32>(state_.regs[inst->mul.rm])) *
+                 static_cast<s32>(state_.regs[inst->mul.rs]);
+    state_.regs[inst->rd] = static_cast<u32>(result);
+    state_.regs[inst->mul.rdhi] = static_cast<u32>(result >> 32);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_SmullS: {
+    CHECK_COND();
+    s64 result = static_cast<s64>(static_cast<s32>(state_.regs[inst->mul.rm])) *
+                 static_cast<s32>(state_.regs[inst->mul.rs]);
+    state_.regs[inst->rd] = static_cast<u32>(result);
+    state_.regs[inst->mul.rdhi] = static_cast<u32>(result >> 32);
+    state_.lazy_flags.Materialize();
+    state_.lazy_flags.op = FlagOp::Mul;
+    // 64-bit N/Z packing, as in UmullS
+    state_.lazy_flags.result =
+        static_cast<u32>(static_cast<u64>(result) >> 32) | (static_cast<u32>(result) ? 1u : 0u);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Smlal: {
+    CHECK_COND();
+    s64 accum = (static_cast<s64>(state_.regs[inst->mul.rdhi]) << 32) |
+                static_cast<u64>(state_.regs[inst->rd]);
+    s64 result = static_cast<s64>(static_cast<s32>(state_.regs[inst->mul.rm])) *
+                 static_cast<s32>(state_.regs[inst->mul.rs]) + accum;
+    state_.regs[inst->rd] = static_cast<u32>(result);
+    state_.regs[inst->mul.rdhi] = static_cast<u32>(result >> 32);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_SmlalS: {
+    CHECK_COND();
+    s64 accum = (static_cast<s64>(state_.regs[inst->mul.rdhi]) << 32) |
+                static_cast<u64>(state_.regs[inst->rd]);
+    s64 result = static_cast<s64>(static_cast<s32>(state_.regs[inst->mul.rm])) *
+                 static_cast<s32>(state_.regs[inst->mul.rs]) + accum;
+    state_.regs[inst->rd] = static_cast<u32>(result);
+    state_.regs[inst->mul.rdhi] = static_cast<u32>(result >> 32);
+    state_.lazy_flags.Materialize();
+    state_.lazy_flags.op = FlagOp::Mul;
+    // 64-bit N/Z packing, as in UmullS
+    state_.lazy_flags.result =
+        static_cast<u32>(static_cast<u64>(result) >> 32) | (static_cast<u32>(result) ? 1u : 0u);
+    ADVANCE_AND_DISPATCH();
+}
+
+// Halfword multiplies: SMUL<x><y>, SMLA<x><y>, SMULW<y>, SMLAW<y>, SMLAL<x><y>
+// mul.flags bit0 = x (Rm half), bit1 = y (Rs half). None of these touch NZCV.
+// SMLA<x><y> and SMLAW<y> set Q (CPSR[27]) on signed overflow of the addition;
+// SMLAL<x><y> accumulates into 64 bits and does not affect Q.
+
+handle_Smulxy: {
+    CHECK_COND();
+    const u32 rm_val = state_.regs[inst->mul.rm];
+    const u32 rs_val = state_.regs[inst->mul.rs];
+    const s32 op1 = static_cast<s16>((inst->mul.flags & 1) ? (rm_val >> 16) : rm_val);
+    const s32 op2 = static_cast<s16>((inst->mul.flags & 2) ? (rs_val >> 16) : rs_val);
+    state_.regs[inst->rd] = static_cast<u32>(op1 * op2);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Smlaxy: {
+    CHECK_COND();
+    const u32 rm_val = state_.regs[inst->mul.rm];
+    const u32 rs_val = state_.regs[inst->mul.rs];
+    const s32 op1 = static_cast<s16>((inst->mul.flags & 1) ? (rm_val >> 16) : rm_val);
+    const s32 op2 = static_cast<s16>((inst->mul.flags & 2) ? (rs_val >> 16) : rs_val);
+    const u32 product = static_cast<u32>(op1 * op2);
+    const u32 accum = state_.regs[inst->mul.rn];
+    const u32 result = product + accum;
+    if ((~(product ^ accum) & (product ^ result)) >> 31) {
+        state_.cpsr_other |= (1 << 27); // Q flag on signed overflow
+    }
+    state_.regs[inst->rd] = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Smulwy: {
+    CHECK_COND();
+    const u32 rs_val = state_.regs[inst->mul.rs];
+    const s32 op2 = static_cast<s16>((inst->mul.flags & 2) ? (rs_val >> 16) : rs_val);
+    const s64 product = static_cast<s64>(static_cast<s32>(state_.regs[inst->mul.rm])) * op2;
+    state_.regs[inst->rd] = static_cast<u32>(product >> 16);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Smlawy: {
+    CHECK_COND();
+    const u32 rs_val = state_.regs[inst->mul.rs];
+    const s32 op2 = static_cast<s16>((inst->mul.flags & 2) ? (rs_val >> 16) : rs_val);
+    const s64 product = static_cast<s64>(static_cast<s32>(state_.regs[inst->mul.rm])) * op2;
+    const u32 product_hi = static_cast<u32>(product >> 16);
+    const u32 accum = state_.regs[inst->mul.rn];
+    const u32 result = product_hi + accum;
+    if ((~(product_hi ^ accum) & (product_hi ^ result)) >> 31) {
+        state_.cpsr_other |= (1 << 27); // Q flag on signed overflow
+    }
+    state_.regs[inst->rd] = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Smlalxy: {
+    CHECK_COND();
+    const u32 rm_val = state_.regs[inst->mul.rm];
+    const u32 rs_val = state_.regs[inst->mul.rs];
+    const s32 op1 = static_cast<s16>((inst->mul.flags & 1) ? (rm_val >> 16) : rm_val);
+    const s32 op2 = static_cast<s16>((inst->mul.flags & 2) ? (rs_val >> 16) : rs_val);
+    const u64 accum =
+        (static_cast<u64>(state_.regs[inst->mul.rdhi]) << 32) | state_.regs[inst->rd];
+    const u64 result = accum + static_cast<u64>(static_cast<s64>(op1 * op2));
+    state_.regs[inst->rd] = static_cast<u32>(result);
+    state_.regs[inst->mul.rdhi] = static_cast<u32>(result >> 32);
+    ADVANCE_AND_DISPATCH();
+}
diff --git a/src/core/arm/fastinterp/handlers/arm_vfp.inc b/src/core/arm/fastinterp/handlers/arm_vfp.inc
new file mode 100644
index 0000000..9ac9a4f
--- /dev/null
+++ b/src/core/arm/fastinterp/handlers/arm_vfp.inc
@@ -0,0 +1,490 @@
+// Copyright 2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// VFP (Floating Point) handlers: Register transfers (VmovArmToS, etc.),
+//     Single precision (VaddS, VsubS, etc.), Double precision (VaddD, etc.),
+//     Comparison (VcmpS, VcmpD, etc.), Conversion (VcvtSToInt, etc.),
+//     Load/Store (VldrS, VstrS, VldrD, VstrD)
+
+// Helper macros for VFP register access (bit_cast/memcpy: no aliasing UB).
+// #undef'd at the bottom of this file.
+#define VFP_S_READ(idx) (std::bit_cast<float>(state_.vfp_regs[(idx)]))
+#define VFP_S_WRITE(idx, val) \
+    (state_.vfp_regs[(idx)] = std::bit_cast<u32>(static_cast<float>(val)))
+#define VFP_S_READ_U32(idx) (state_.vfp_regs[(idx)])
+#define VFP_S_WRITE_U32(idx, val) (state_.vfp_regs[(idx)] = (val))
+
+// D-registers are stored as two consecutive u32 halves in vfp_regs
+#define VFP_D_READ(idx) ({ \
+    double vfp_d_read_tmp_; \
+    std::memcpy(&vfp_d_read_tmp_, &state_.vfp_regs[(idx) * 2], sizeof(vfp_d_read_tmp_)); \
+    vfp_d_read_tmp_; \
+})
+#define VFP_D_WRITE(idx, val) do { \
+    double vfp_d_tmp_ = (val); \
+    std::memcpy(&state_.vfp_regs[(idx) * 2], &vfp_d_tmp_, sizeof(vfp_d_tmp_)); \
+} while(0)
+
+// VFP Register Transfer: VMOV ARM to single VFP
+handle_VmovArmToS:
+    CHECK_COND();
+    VFP_S_WRITE_U32(inst->vfp.sd, state_.regs[inst->vfp.rt]);
+    ADVANCE_AND_DISPATCH();
+
+handle_VmovSToArm:
+    CHECK_COND();
+    state_.regs[inst->vfp.rt] = VFP_S_READ_U32(inst->vfp.sd);
+    ADVANCE_AND_DISPATCH();
+
+handle_VmovArmToD:
+    CHECK_COND();
+    state_.vfp_regs[inst->vfp.sd * 2] = state_.regs[inst->vfp.rt];
+    state_.vfp_regs[inst->vfp.sd * 2 + 1] = state_.regs[inst->vfp.rt2];
+    ADVANCE_AND_DISPATCH();
+
+handle_VmovDToArm:
+    CHECK_COND();
+    state_.regs[inst->vfp.rt] = state_.vfp_regs[inst->vfp.sd * 2];
+    state_.regs[inst->vfp.rt2] = state_.vfp_regs[inst->vfp.sd * 2 + 1];
+    ADVANCE_AND_DISPATCH();
+
+handle_Vmrs:
+    CHECK_COND();
+    if (inst->vfp.rt == 15) {
+        // Move FPSCR flags to CPSR (APSR_nzcv); SetPacked masks to bits 31-28
+        state_.lazy_flags.SetPacked(state_.fpscr);
+    } else {
+        state_.regs[inst->vfp.rt] = state_.fpscr;
+    }
+    ADVANCE_AND_DISPATCH();
+
+handle_Vmsr:
+    CHECK_COND();
+    state_.fpscr = state_.regs[inst->vfp.rt];
+    ADVANCE_AND_DISPATCH();
+
+handle_VaddS:
+    CHECK_COND();
+    VFP_S_WRITE(inst->vfp.sd, VFP_S_READ(inst->vfp.sn) + VFP_S_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VsubS:
+    CHECK_COND();
+    VFP_S_WRITE(inst->vfp.sd, VFP_S_READ(inst->vfp.sn) - VFP_S_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VmulS:
+    CHECK_COND();
+    VFP_S_WRITE(inst->vfp.sd, VFP_S_READ(inst->vfp.sn) * VFP_S_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VdivS:
+    CHECK_COND();
+    VFP_S_WRITE(inst->vfp.sd, VFP_S_READ(inst->vfp.sn) / VFP_S_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VmlaS:
+    CHECK_COND();
+    VFP_S_WRITE(inst->vfp.sd, VFP_S_READ(inst->vfp.sd) + VFP_S_READ(inst->vfp.sn) * VFP_S_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VmlsS:
+    CHECK_COND();
+    VFP_S_WRITE(inst->vfp.sd, VFP_S_READ(inst->vfp.sd) - VFP_S_READ(inst->vfp.sn) * VFP_S_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VnmlaS:
+    CHECK_COND();
+    VFP_S_WRITE(inst->vfp.sd, -VFP_S_READ(inst->vfp.sd) - VFP_S_READ(inst->vfp.sn) * VFP_S_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VnmlsS:
+    CHECK_COND();
+    VFP_S_WRITE(inst->vfp.sd, -VFP_S_READ(inst->vfp.sd) + VFP_S_READ(inst->vfp.sn) * VFP_S_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VnmulS:
+    CHECK_COND();
+    VFP_S_WRITE(inst->vfp.sd, -(VFP_S_READ(inst->vfp.sn) * VFP_S_READ(inst->vfp.sm)));
+    ADVANCE_AND_DISPATCH();
+
+handle_VabsS:
+    CHECK_COND();
+    VFP_S_WRITE(inst->vfp.sd, std::fabs(VFP_S_READ(inst->vfp.sm)));
+    ADVANCE_AND_DISPATCH();
+
+handle_VnegS:
+    CHECK_COND();
+    VFP_S_WRITE(inst->vfp.sd, -VFP_S_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VsqrtS:
+    CHECK_COND();
+    VFP_S_WRITE(inst->vfp.sd, std::sqrt(VFP_S_READ(inst->vfp.sm)));
+    ADVANCE_AND_DISPATCH();
+
+handle_VmovS:
+    CHECK_COND();
+    VFP_S_WRITE_U32(inst->vfp.sd, VFP_S_READ_U32(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+// Expanded constant precomputed at decode into vimm.lo
+handle_VmovImmS:
+    CHECK_COND();
+    VFP_S_WRITE_U32(inst->vimm.sd, inst->vimm.lo);
+    ADVANCE_AND_DISPATCH();
+
+handle_VaddD:
+    CHECK_COND();
+    VFP_D_WRITE(inst->vfp.sd, VFP_D_READ(inst->vfp.sn) + VFP_D_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VsubD:
+    CHECK_COND();
+    VFP_D_WRITE(inst->vfp.sd, VFP_D_READ(inst->vfp.sn) - VFP_D_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VmulD:
+    CHECK_COND();
+    VFP_D_WRITE(inst->vfp.sd, VFP_D_READ(inst->vfp.sn) * VFP_D_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VdivD:
+    CHECK_COND();
+    VFP_D_WRITE(inst->vfp.sd, VFP_D_READ(inst->vfp.sn) / VFP_D_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VmlaD:
+    CHECK_COND();
+    VFP_D_WRITE(inst->vfp.sd, VFP_D_READ(inst->vfp.sd) + VFP_D_READ(inst->vfp.sn) * VFP_D_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VmlsD:
+    CHECK_COND();
+    VFP_D_WRITE(inst->vfp.sd, VFP_D_READ(inst->vfp.sd) - VFP_D_READ(inst->vfp.sn) * VFP_D_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VnmlaD:
+    CHECK_COND();
+    VFP_D_WRITE(inst->vfp.sd, -VFP_D_READ(inst->vfp.sd) - VFP_D_READ(inst->vfp.sn) * VFP_D_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VnmlsD:
+    CHECK_COND();
+    VFP_D_WRITE(inst->vfp.sd, -VFP_D_READ(inst->vfp.sd) + VFP_D_READ(inst->vfp.sn) * VFP_D_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VnmulD:
+    CHECK_COND();
+    VFP_D_WRITE(inst->vfp.sd, -(VFP_D_READ(inst->vfp.sn) * VFP_D_READ(inst->vfp.sm)));
+    ADVANCE_AND_DISPATCH();
+
+handle_VabsD:
+    CHECK_COND();
+    VFP_D_WRITE(inst->vfp.sd, std::fabs(VFP_D_READ(inst->vfp.sm)));
+    ADVANCE_AND_DISPATCH();
+
+handle_VnegD:
+    CHECK_COND();
+    VFP_D_WRITE(inst->vfp.sd, -VFP_D_READ(inst->vfp.sm));
+    ADVANCE_AND_DISPATCH();
+
+handle_VsqrtD:
+    CHECK_COND();
+    VFP_D_WRITE(inst->vfp.sd, std::sqrt(VFP_D_READ(inst->vfp.sm)));
+    ADVANCE_AND_DISPATCH();
+
+handle_VmovD:
+    CHECK_COND();
+    state_.vfp_regs[inst->vfp.sd * 2] = state_.vfp_regs[inst->vfp.sm * 2];
+    state_.vfp_regs[inst->vfp.sd * 2 + 1] = state_.vfp_regs[inst->vfp.sm * 2 + 1];
+    ADVANCE_AND_DISPATCH();
+
+// Expanded constant precomputed at decode into vimm.lo/hi
+handle_VmovImmD:
+    CHECK_COND();
+    state_.vfp_regs[inst->vimm.sd * 2] = inst->vimm.lo;
+    state_.vfp_regs[inst->vimm.sd * 2 + 1] = inst->vimm.hi;
+    ADVANCE_AND_DISPATCH();
+
+handle_VcmpS:
+    CHECK_COND();
+    {
+        float a = VFP_S_READ(inst->vfp.sd);
+        float b = VFP_S_READ(inst->vfp.sm);
+        u32 flags = 0;
+        if (std::isnan(a) || std::isnan(b)) {
+            flags = 0x30000000;  // C=1, V=1 (unordered)
+        } else if (a == b) {
+            flags = 0x60000000;  // Z=1, C=1
+        } else if (a < b) {
+            flags = 0x80000000;  // N=1
+        } else {
+            flags = 0x20000000;  // C=1
+        }
+        state_.fpscr = (state_.fpscr & 0x0FFFFFFF) | flags;
+    }
+    ADVANCE_AND_DISPATCH();
+
+handle_VcmpD:
+    CHECK_COND();
+    {
+        double a = VFP_D_READ(inst->vfp.sd);
+        double b = VFP_D_READ(inst->vfp.sm);
+        u32 flags = 0;
+        if (std::isnan(a) || std::isnan(b)) {
+            flags = 0x30000000;  // C=1, V=1 (unordered)
+        } else if (a == b) {
+            flags = 0x60000000;  // Z=1, C=1
+        } else if (a < b) {
+            flags = 0x80000000;  // N=1
+        } else {
+            flags = 0x20000000;  // C=1
+        }
+        state_.fpscr = (state_.fpscr & 0x0FFFFFFF) | flags;
+    }
+    ADVANCE_AND_DISPATCH();
+
+handle_VcmpzS:
+    CHECK_COND();
+    {
+        float a = VFP_S_READ(inst->vfp.sd);
+        u32 flags = 0;
+        if (std::isnan(a)) {
+            flags = 0x30000000;  // C=1, V=1 (unordered)
+        } else if (a == 0.0f) {
+            flags = 0x60000000;  // Z=1, C=1
+        } else if (a < 0.0f) {
+            flags = 0x80000000;  // N=1
+        } else {
+            flags = 0x20000000;  // C=1
+        }
+        state_.fpscr = (state_.fpscr & 0x0FFFFFFF) | flags;
+    }
+    ADVANCE_AND_DISPATCH();
+
+handle_VcmpzD:
+    CHECK_COND();
+    {
+        double a = VFP_D_READ(inst->vfp.sd);
+        u32 flags = 0;
+        if (std::isnan(a)) {
+            flags = 0x30000000;  // C=1, V=1 (unordered)
+        } else if (a == 0.0) {
+            flags = 0x60000000;  // Z=1, C=1
+        } else if (a < 0.0) {
+            flags = 0x80000000;  // N=1
+        } else {
+            flags = 0x20000000;  // C=1
+        }
+        state_.fpscr = (state_.fpscr & 0x0FFFFFFF) | flags;
+    }
+    ADVANCE_AND_DISPATCH();
+
