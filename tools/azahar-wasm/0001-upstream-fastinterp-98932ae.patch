+    const u32 n = result >> 31;
+    const u32 z = (result == 0) ? 1u : 0u;
+    const u32 nzcv = (n << 31) | (z << 30) | (old_nzcv & 0x30000000u);
+
+    state_.lazy_flags.SetPacked(nzcv);
+    executed += inst->ticks;
+
+    // Fast path for EQ (common for bit testing)
+    if (inst->fused.branch_cond == 0) {
+        if (z) {
+            SET_PC(inst->fused.branch_target);
+            goto chain;
+        }
+        SET_PC(GET_PC() + inst->fused.combined_size);
+        DISPATCH();
+    }
+
+    if (inst->fused.branch_cond == 1) {
+        if (!z) {
+            SET_PC(inst->fused.branch_target);
+            goto chain;
+        }
+        SET_PC(GET_PC() + inst->fused.combined_size);
+        DISPATCH();
+    }
+
+    if (CondPassed(inst->fused.branch_cond, nzcv)) {
+        SET_PC(inst->fused.branch_target);
+        goto chain;
+    }
+    SET_PC(GET_PC() + inst->fused.combined_size);
+    DISPATCH();
+}
+
+handle_FusedAddCmpBcc: {
+    // ARM: ADD Rd, Rn, #imm; CMP Rd, Rm; B<cond> label (iterator loop pattern)
+    // First: ADD Rd, Rn, #imm
+    u32 add_result = state_.regs[inst->fused.rn] + inst->fused.imm;
+    state_.regs[inst->rd] = add_result;
+
+    // Second: CMP Rd, Rm (compare add result with rm)
+    u32 op1 = add_result;
+    u32 op2 = state_.regs[inst->fused.rm];
+    u32 cmp_result = op1 - op2;
+
+    // Fast path for LT (common in "i < limit" loops)
+    if (inst->fused.branch_cond == 0xB) {
+        bool n = (cmp_result >> 31) & 1;
+        bool v = ((op1 ^ op2) & (op1 ^ cmp_result)) >> 31;
+        state_.lazy_flags.op = FlagOp::Cmp;
+        state_.lazy_flags.result = cmp_result;
+        state_.lazy_flags.operand1 = op1;
+        state_.lazy_flags.operand2 = op2;
+        executed += inst->ticks;
+        if (n != v) {
+            SET_PC(inst->fused.branch_target);
+            goto chain;
+        }
+        SET_PC(GET_PC() + inst->fused.combined_size);
+        DISPATCH();
+    }
+
+    const u32 n = cmp_result >> 31;
+    const u32 z = (cmp_result == 0) ? 1u : 0u;
+    const u32 c = (op1 >= op2) ? 1u : 0u;
+    const u32 v = ((op1 ^ op2) & (op1 ^ cmp_result)) >> 31;
+    const u32 nzcv = (n << 31) | (z << 30) | (c << 29) | (v << 28);
+
+    state_.lazy_flags.SetPacked(nzcv);
+    executed += inst->ticks;
+
+    if (CondPassed(inst->fused.branch_cond, nzcv)) {
+        SET_PC(inst->fused.branch_target);
+        goto chain;
+    }
+    SET_PC(GET_PC() + inst->fused.combined_size);
+    DISPATCH();
+}
+
+// ============================================================================
+// Unrolled Loop Handlers
+// ============================================================================
+// Generated by ReoptimizeHotBlock for hot blocks that are tight self-loops.
+
+handle_ThumbUnrolledSubsLoop: {
+    // Thumb: SUBS Rd, #imm8; BNE self - tight countdown loop
+    // Execute up to 16 iterations inline before returning to dispatcher
+    constexpr int UNROLL_COUNT = 16;
+
+    u8 rd = inst->rd;
+    u32 imm = inst->fused.imm;
+    u32 value = state_.regs[rd];
+    u32 last_operand1;
+
+    // Execute iterations until result is 0 (BNE fails) or UNROLL_COUNT reached
+    // Always do at least one iteration since original SUBS always executes
+    int iterations = 0;
+    if (imm == 1) {
+        // Dominant case: closed form instead of a serial dependent-subtract
+        // chain. Matches the loop exactly: result = final value, operand1 =
+        // value before the last subtraction, operand2 = imm.
+        iterations = (value >= 1 && value <= UNROLL_COUNT) ? static_cast<int>(value)
+                                                           : UNROLL_COUNT;
+        last_operand1 = value - (iterations - 1);
+        value -= iterations;
+    } else {
+        while (iterations < UNROLL_COUNT) {
+            last_operand1 = value;
+            value -= imm;  // May wrap around
+            iterations++;
+            if (value == 0) break;  // BNE would not branch (Z flag set)
+        }
+    }
+
+    state_.regs[rd] = value;
+    executed += iterations * inst->ticks;  // inst->ticks = per-iteration tick cost
+
+    state_.lazy_flags.op = FlagOp::Sub;
+    state_.lazy_flags.result = value;
+    state_.lazy_flags.operand1 = last_operand1;
+    state_.lazy_flags.operand2 = imm;
+
+    if (value != 0) {
+        // Loop continues: re-enter this block via chain, skipping Run()
+        goto chain;
+    }
+
+    // Loop finished - advance past the fused instruction
+    SET_PC(GET_PC() + inst->fused.combined_size);
+    DISPATCH();
+}
+
+handle_ArmUnrolledSubsLoop: {
+    // ARM: SUBS Rd, Rn, #imm; BNE self - tight countdown loop
+    constexpr int UNROLL_COUNT = 16;
+
+    u8 rd = inst->rd;
+    u8 rn = inst->fused.rn;
+    u32 imm = inst->fused.imm;
+    u32 value = state_.regs[rn];
+    u32 last_operand1;
+
+    int iterations = 0;
+    if (rd == rn) {
+        // SUBS Rd, Rd, #imm - can unroll multiple iterations
+        if (imm == 1) {
+            // Dominant case: closed form instead of a serial dependent-subtract
+            // chain. Matches the loop exactly: result = final value, operand1 =
+            // value before the last subtraction, operand2 = imm.
+            iterations = (value >= 1 && value <= UNROLL_COUNT) ? static_cast<int>(value)
+                                                               : UNROLL_COUNT;
+            last_operand1 = value - (iterations - 1);
+            value -= iterations;
+        } else {
+            while (iterations < UNROLL_COUNT) {
+                last_operand1 = value;
+                value -= imm;  // May wrap around
+                iterations++;
+                if (value == 0) break;  // BNE would not branch
+            }
+        }
+        state_.regs[rd] = value;
+    } else {
+        // Rd != Rn case - just do one iteration (can't chain)
+        last_operand1 = value;
+        value = state_.regs[rn] - imm;
+        state_.regs[rd] = value;
+        iterations = 1;
+    }
+
+    executed += iterations * inst->ticks;
+
+    state_.lazy_flags.op = FlagOp::Sub;
+    state_.lazy_flags.result = value;
+    state_.lazy_flags.operand1 = last_operand1;
+    state_.lazy_flags.operand2 = imm;
+
+    if (value != 0) {
+        // Loop continues: re-enter this block via chain, skipping Run()
+        goto chain;
+    }
+
+    SET_PC(GET_PC() + inst->fused.combined_size);
+    DISPATCH();
+}
+
+handle_ThumbUnrolledCmpLoop: {
+    // Thumb: CMP Rn, Rm; BNE self - spin/wait loop. Nothing to unroll
+    // (the values only change externally); execute one iteration.
+
+    u8 rn = inst->fused.rn;
+    u8 rm = inst->fused.rm;
+    u32 op1 = state_.regs[rn];
+    u32 op2 = state_.regs[rm];
+    u32 result = op1 - op2;
+
+    state_.lazy_flags.op = FlagOp::Cmp;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = op2;
+
+    executed += inst->ticks;
+
+    if (result != 0) {
+        // Still not equal: re-enter this block via chain, skipping Run()
+        goto chain;
+    }
+
+    SET_PC(GET_PC() + inst->fused.combined_size);
+    DISPATCH();
+}
diff --git a/src/core/arm/fastinterp/handlers/special.inc b/src/core/arm/fastinterp/handlers/special.inc
new file mode 100644
index 0000000..438dc19
--- /dev/null
+++ b/src/core/arm/fastinterp/handlers/special.inc
@@ -0,0 +1,23 @@
+// Copyright 2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// Special handlers: Invalid, Nop, EndBlock, PcSetup
+
+handle_Invalid:
+    // Invalid instruction - stop execution
+    goto done;
+
+handle_Nop:
+    ADVANCE_AND_DISPATCH();
+
+handle_EndBlock:
+    // Synthetic block terminator (zero ticks): chain straight to the next block
+    // instead of returning to Run().
+    goto chain;
+
+handle_PcSetup:
+    // Materialize the precomputed PC into regs[15] for the next instruction, which
+    // reads R15 as a source and couldn't be folded at decode. Zero ticks; no PC advance.
+    state_.regs[15] = inst->imm32;
+    DISPATCH();
diff --git a/src/core/arm/fastinterp/handlers/thumb16.inc b/src/core/arm/fastinterp/handlers/thumb16.inc
new file mode 100644
index 0000000..6b0a4c5
--- /dev/null
+++ b/src/core/arm/fastinterp/handlers/thumb16.inc
@@ -0,0 +1,1124 @@
+// Copyright 2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// Thumb16 handlers, working directly on the Thumb encoding (no ARM translation).
+//
+// All operand fields are pre-decoded by DecodeThumb16() into:
+//   inst->rd, inst->dp.rn, inst->dp.rm, inst->dp.imm, inst->dp.shift_imm,
+//   inst->lsm.rn, inst->lsm.reg_list, inst->branch.target
+// Immediate offsets are pre-scaled (e.g. imm5*4 for word loads).
+
+handle_ThumbLslImm: {
+    const u8 rd = inst->rd;
+    const u8 rm = inst->dp.rm;
+    const u8 imm5 = inst->dp.shift_imm;
+    u32 val = state_.regs[rm];
+    state_.lazy_flags.Materialize(); // preserve old C/V in nzcv before overwriting op
+    bool carry;
+    if (imm5 != 0) {
+        carry = (val >> (32 - imm5)) & 1;
+        val <<= imm5;
+    } else {
+        carry = state_.lazy_flags.GetC();
+    }
+    state_.regs[rd] = val;
+    state_.lazy_flags.op = FlagOp::Mov;
+    state_.lazy_flags.result = val;
+    state_.lazy_flags.shifter_carry = carry;
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbLsrImm: {
+    const u8 rd = inst->rd;
+    const u8 rm = inst->dp.rm;
+    u8 imm5 = inst->dp.shift_imm;
+    if (imm5 == 0) imm5 = 32;
+    u32 val = state_.regs[rm];
+    state_.lazy_flags.Materialize(); // preserve old V in nzcv before overwriting op
+    bool carry = (imm5 == 32) ? ((val >> 31) & 1) : ((val >> (imm5 - 1)) & 1);
+    val = (imm5 == 32) ? 0 : (val >> imm5);
+    state_.regs[rd] = val;
+    state_.lazy_flags.op = FlagOp::Mov;
+    state_.lazy_flags.result = val;
+    state_.lazy_flags.shifter_carry = carry;
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbAsrImm: {
+    const u8 rd = inst->rd;
+    const u8 rm = inst->dp.rm;
+    u8 imm5 = inst->dp.shift_imm;
+    if (imm5 == 0) imm5 = 32;
+    s32 val = static_cast<s32>(state_.regs[rm]);
+    state_.lazy_flags.Materialize(); // preserve old V in nzcv before overwriting op
+    bool carry = (imm5 >= 32) ? ((val >> 31) & 1) : ((val >> (imm5 - 1)) & 1);
+    val = (imm5 >= 32) ? (val >> 31) : (val >> imm5);
+    state_.regs[rd] = static_cast<u32>(val);
+    state_.lazy_flags.op = FlagOp::Mov;
+    state_.lazy_flags.result = static_cast<u32>(val);
+    state_.lazy_flags.shifter_carry = carry;
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbAddReg3: {
+    const u8 rd = inst->rd;
+    const u8 rn = inst->dp.rn;
+    const u8 rm = inst->dp.rm;
+    u32 op1 = state_.regs[rn];
+    u32 op2 = state_.regs[rm];
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_ADDS(result, op1, op2, nzcv);
+    state_.regs[rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 + op2;
+    state_.regs[rd] = result;
+    state_.lazy_flags.op = FlagOp::Add;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = op2;
+#endif
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbSubReg3: {
+    const u8 rd = inst->rd;
+    const u8 rn = inst->dp.rn;
+    const u8 rm = inst->dp.rm;
+    u32 op1 = state_.regs[rn];
+    u32 op2 = state_.regs[rm];
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_SUBS(result, op1, op2, nzcv);
+    state_.regs[rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 - op2;
+    state_.regs[rd] = result;
+    state_.lazy_flags.op = FlagOp::Sub;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = op2;
+#endif
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbAddImm3: {
+    const u8 rd = inst->rd;
+    const u8 rn = inst->dp.rn;
+    const u32 imm3 = inst->dp.imm;
+    u32 op1 = state_.regs[rn];
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_ADDS(result, op1, imm3, nzcv);
+    state_.regs[rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 + imm3;
+    state_.regs[rd] = result;
+    state_.lazy_flags.op = FlagOp::Add;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = imm3;
+#endif
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbSubImm3: {
+    const u8 rd = inst->rd;
+    const u8 rn = inst->dp.rn;
+    const u32 imm3 = inst->dp.imm;
+    u32 op1 = state_.regs[rn];
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_SUBS(result, op1, imm3, nzcv);
+    state_.regs[rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 - imm3;
+    state_.regs[rd] = result;
+    state_.lazy_flags.op = FlagOp::Sub;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = imm3;
+#endif
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbMovImm8: {
+    const u8 rd = inst->rd;
+    const u32 imm8 = inst->dp.imm;
+    const u32 old_nzcv = state_.lazy_flags.GetPacked();
+#ifdef __aarch64__
+    u32 nzcv;
+    ARM64_MOVS(state_.regs[rd], imm8, nzcv, ARM64_CV_KEEP(old_nzcv));
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    state_.regs[rd] = imm8;
+    state_.lazy_flags.op = FlagOp::Mov;
+    state_.lazy_flags.result = imm8;
+    state_.lazy_flags.shifter_carry = (old_nzcv >> 29) & 1;
+#endif
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbCmpImm8: {
+    const u8 rn = inst->rd;
+    const u32 imm8 = inst->dp.imm;
+    u32 op1 = state_.regs[rn];
+#ifdef __aarch64__
+    u32 nzcv;
+    ARM64_CMP(op1, imm8, nzcv);
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 - imm8;
+    state_.lazy_flags.op = FlagOp::Cmp;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = imm8;
+#endif
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbAddImm8: {
+    const u8 rd = inst->rd;
+    const u32 imm8 = inst->dp.imm;
+    u32 op1 = state_.regs[rd];
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_ADDS(result, op1, imm8, nzcv);
+    state_.regs[rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 + imm8;
+    state_.regs[rd] = result;
+    state_.lazy_flags.op = FlagOp::Add;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = imm8;
+#endif
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbSubImm8: {
+    const u8 rd = inst->rd;
+    const u32 imm8 = inst->dp.imm;
+    u32 op1 = state_.regs[rd];
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_SUBS(result, op1, imm8, nzcv);
+    state_.regs[rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 - imm8;
+    state_.regs[rd] = result;
+    state_.lazy_flags.op = FlagOp::Sub;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = imm8;
+#endif
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbAnd: {
+    const u8 rd = inst->rd;
+    const u8 rm = inst->dp.rm;
+    u32 op1 = state_.regs[rd];
+    u32 op2 = state_.regs[rm];
+    const u32 old_nzcv = state_.lazy_flags.GetPacked();
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_ANDS(result, op1, op2, nzcv, ARM64_CV_KEEP(old_nzcv));
+    state_.regs[rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 & op2;
+    state_.regs[rd] = result;
+    state_.lazy_flags.op = FlagOp::And;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.shifter_carry = (old_nzcv >> 29) & 1;
+#endif
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbEor: {
+    const u8 rd = inst->rd;
+    const u8 rm = inst->dp.rm;
+    u32 op1 = state_.regs[rd];
+    u32 op2 = state_.regs[rm];
+    const u32 old_nzcv = state_.lazy_flags.GetPacked();
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_EORS(result, op1, op2, nzcv, ARM64_CV_KEEP(old_nzcv));
+    state_.regs[rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 ^ op2;
+    state_.regs[rd] = result;
+    state_.lazy_flags.op = FlagOp::Eor;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.shifter_carry = (old_nzcv >> 29) & 1;
+#endif
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbLslReg: {
+    const u8 rd = inst->rd;
+    const u8 rs = inst->dp.rm;
+    u32 val = state_.regs[rd];
+    u8 shift = state_.regs[rs] & 0xFF;
+    bool carry = state_.lazy_flags.GetC(); // materializes; V preserved in nzcv
+    if (shift != 0) {
+        if (shift < 32) {
+            carry = (val >> (32 - shift)) & 1;
+            val <<= shift;
+        } else if (shift == 32) {
+            carry = val & 1;
+            val = 0;
+        } else {
+            carry = 0;
+            val = 0;
+        }
+    }
+    state_.regs[rd] = val;
+    state_.lazy_flags.op = FlagOp::Mov;
+    state_.lazy_flags.result = val;
+    state_.lazy_flags.shifter_carry = carry;
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbLsrReg: {
+    const u8 rd = inst->rd;
+    const u8 rs = inst->dp.rm;
+    u32 val = state_.regs[rd];
+    u8 shift = state_.regs[rs] & 0xFF;
+    bool carry = state_.lazy_flags.GetC(); // materializes; V preserved in nzcv
+    if (shift != 0) {
+        if (shift < 32) {
+            carry = (val >> (shift - 1)) & 1;
+            val >>= shift;
+        } else if (shift == 32) {
+            carry = (val >> 31) & 1;
+            val = 0;
+        } else {
+            carry = 0;
+            val = 0;
+        }
+    }
+    state_.regs[rd] = val;
+    state_.lazy_flags.op = FlagOp::Mov;
+    state_.lazy_flags.result = val;
+    state_.lazy_flags.shifter_carry = carry;
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbAsrReg: {
+    const u8 rd = inst->rd;
+    const u8 rs = inst->dp.rm;
+    s32 val = static_cast<s32>(state_.regs[rd]);
+    u8 shift = state_.regs[rs] & 0xFF;
+    bool carry = state_.lazy_flags.GetC(); // materializes; V preserved in nzcv
+    if (shift != 0) {
+        if (shift < 32) {
+            carry = (val >> (shift - 1)) & 1;
+            val >>= shift;
+        } else {
+            carry = (val >> 31) & 1;
+            val = val >> 31;
+        }
+    }
+    state_.regs[rd] = static_cast<u32>(val);
+    state_.lazy_flags.op = FlagOp::Mov;
+    state_.lazy_flags.result = static_cast<u32>(val);
+    state_.lazy_flags.shifter_carry = carry;
+    executed += inst->ticks;
+    SET_PC(GET_PC() + 2);
+    DISPATCH();
+}
+
+handle_ThumbAdc: {
+    const u8 rd = inst->rd;
+    const u8 rm = inst->dp.rm;
+    u32 op1 = state_.regs[rd];
