+// Copyright 2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include "common/common_types.h"
+#include "core/arm/fastinterp/fastinterp_flags.h"
+
+namespace Core::FastInterp {
+
+// ============================================================================
+// Instruction Opcodes
+// ============================================================================
+// Each opcode corresponds to a handler in the dispatch table.
+
+enum class Opcode : u16 {
+    // Special
+    Invalid = 0,
+    Nop,
+    EndBlock, // End of basic block - return to dispatcher
+
+    // Data Processing - ALU
+    And,
+    Eor,
+    Sub,
+    Rsb,
+    Add,
+    Adc,
+    Sbc,
+    Rsc,
+    Tst,
+    Teq,
+    Cmp,
+    Cmn,
+    Orr,
+    Mov,
+    Bic,
+    Mvn,
+
+    // Data Processing with S flag (update flags)
+    AndS,
+    EorS,
+    SubS,
+    RsbS,
+    AddS,
+    AdcS,
+    SbcS,
+    RscS,
+    // TstS, TeqS, CmpS, CmnS are always S variants
+    OrrS,
+    MovS,
+    BicS,
+    MvnS,
+
+    // Multiply
+    Mul,
+    MulS,
+    Mla,
+    MlaS,
+    Umull,
+    UmullS,
+    Umlal,
+    UmlalS,
+    Smull,
+    SmullS,
+    Smlal,
+    SmlalS,
+
+    // Load/Store
+    Ldr,
+    LdrB,
+    LdrH,
+    LdrSB,
+    LdrSH,
+    Str,
+    StrB,
+    StrH,
+
+    // Load/Store Multiple
+    Ldm,
+    Stm,
+
+    // Branch
+    B,
+    Bl,
+    Bx,
+    Blx,
+
+    // Miscellaneous
+    Clz,
+    Swi,
+    Mrs,
+    Msr,
+
+    // Extension
+    Sxtb,
+    Sxth,
+    Uxtb,
+    Uxth,
+
+    // Byte reversal
+    Rev,
+    Rev16,
+    Revsh,
+
+    // Saturating arithmetic
+    Qadd,
+    Qsub,
+    Qdadd,
+    Qdsub,
+    Ssat,
+    Usat,
+
+    // Parallel add/sub
+    Sadd16,
+    Ssub16,
+    Sadd8,
+    Ssub8,
+    Uadd16,
+    Usub16,
+    Uadd8,
+    Usub8,
+
+    // Unsigned saturating parallel
+    Uqadd16,
+    Uqsub16,
+    Uqadd8,
+    Uqsub8,
+
+    // Signed saturating parallel
+    Qadd16,
+    Qsub16,
+    Qadd8,
+    Qsub8,
+
+    // Signed halving parallel
+    Shadd16,
+    Shsub16,
+    Shadd8,
+    Shsub8,
+
+    // Unsigned halving parallel
+    Uhadd16,
+    Uhsub16,
+    Uhadd8,
+    Uhsub8,
+
+    // Extend with Add
+    Sxtab,
+    Sxtab16,
+    Sxtah,
+    Uxtab,
+    Uxtab16,
+    Uxtah,
+
+    // Bit field
+    Bfc,
+    Bfi,
+    Sbfx,
+    Ubfx,
+
+    // Bit reversal
+    Rbit,
+
+    // Move top halfword
+    Movt,
+
+    // SIMD/Packed
+    Pkhbt,
+    Pkhtb,
+    Sel,
+    Usad8,
+    Usada8,
+
+    // VFP Register Transfer
+    VmovArmToS, // VMOV Sn, Rt (ARM to single)
+    VmovSToArm, // VMOV Rt, Sn (single to ARM)
+    VmovArmToD, // VMOV Dn, Rt, Rt2 (ARM to double)
+    VmovDToArm, // VMOV Rt, Rt2, Dn (double to ARM)
+    Vmrs,       // VMRS Rt, FPSCR
+    Vmsr,       // VMSR FPSCR, Rt
+
+    // VFP Data Processing (single precision)
+    VaddS,    // VADD.F32
+    VsubS,    // VSUB.F32
+    VmulS,    // VMUL.F32
+    VdivS,    // VDIV.F32
+    VmlaS,    // VMLA.F32 (multiply-accumulate)
+    VmlsS,    // VMLS.F32 (multiply-subtract)
+    VnmlaS,   // VNMLA.F32
+    VnmlsS,   // VNMLS.F32
+    VnmulS,   // VNMUL.F32
+    VabsS,    // VABS.F32
+    VnegS,    // VNEG.F32
+    VsqrtS,   // VSQRT.F32
+    VmovS,    // VMOV.F32 Sd, Sm (register to register)
+    VmovImmS, // VMOV.F32 Sd, #imm
+
+    // VFP Data Processing (double precision)
+    VaddD,    // VADD.F64
+    VsubD,    // VSUB.F64
+    VmulD,    // VMUL.F64
+    VdivD,    // VDIV.F64
+    VmlaD,    // VMLA.F64
+    VmlsD,    // VMLS.F64
+    VnmlaD,   // VNMLA.F64
+    VnmlsD,   // VNMLS.F64
+    VnmulD,   // VNMUL.F64
+    VabsD,    // VABS.F64
+    VnegD,    // VNEG.F64
+    VsqrtD,   // VSQRT.F64
+    VmovD,    // VMOV.F64 Dd, Dm
+    VmovImmD, // VMOV.F64 Dd, #imm
+
+    // VFP Comparison
+    VcmpS,  // VCMP.F32
+    VcmpD,  // VCMP.F64
+    VcmpzS, // VCMP.F32 Sd, #0.0
+    VcmpzD, // VCMP.F64 Dd, #0.0
+
+    // VFP Conversion
+    VcvtSToInt, // VCVT.S32.F32 or VCVT.U32.F32
+    VcvtIntToS, // VCVT.F32.S32 or VCVT.F32.U32
+    VcvtDToS,   // VCVT.F32.F64
+    VcvtSToD,   // VCVT.F64.F32
+    VcvtDToInt, // VCVT.S32.F64 or VCVT.U32.F64
+    VcvtIntToD, // VCVT.F64.S32 or VCVT.F64.U32
+
+    // VFP Load/Store
+    VldrS, // VLDR Sd, [Rn, #imm]
+    VstrS, // VSTR Sd, [Rn, #imm]
+    VldrD, // VLDR Dd, [Rn, #imm]
+    VstrD, // VSTR Dd, [Rn, #imm]
+
+    // VFP Load/Store Multiple
+    VldmS, // VLDM {Sd, Sd+1, ...}
+    VstmS, // VSTM {Sd, Sd+1, ...}
+    VldmD, // VLDM {Dd, Dd+1, ...}
+    VstmD, // VSTM {Dd, Dd+1, ...}
+
+    // =========================================================================
+    // Native Thumb16 opcodes
+    // =========================================================================
+    // These handlers work directly with Thumb encoding, no ARM conversion.
+    // Operands are pre-decoded into rd, dp.*, lsm.*, branch.* fields.
+
+    // Shift by immediate (format: 000 op imm5 Rm Rd)
+    ThumbLslImm, // LSL Rd, Rm, #imm5
+    ThumbLsrImm, // LSR Rd, Rm, #imm5
+    ThumbAsrImm, // ASR Rd, Rm, #imm5
+
+    // Add/Sub register 3-operand (format: 000110x Rm Rn Rd)
+    ThumbAddReg3, // ADD Rd, Rn, Rm
+    ThumbSubReg3, // SUB Rd, Rn, Rm
+
+    // Add/Sub 3-bit immediate (format: 000111x imm3 Rn Rd)
+    ThumbAddImm3, // ADD Rd, Rn, #imm3
+    ThumbSubImm3, // SUB Rd, Rn, #imm3
+
+    // 8-bit immediate operations (format: 001 op Rd imm8)
+    ThumbMovImm8, // MOV Rd, #imm8
+    ThumbCmpImm8, // CMP Rn, #imm8
+    ThumbAddImm8, // ADD Rd, #imm8
+    ThumbSubImm8, // SUB Rd, #imm8
+
+    // Data processing register (format: 010000 op Rm Rd)
+    ThumbAnd,    // AND Rd, Rm
+    ThumbEor,    // EOR Rd, Rm
+    ThumbLslReg, // LSL Rd, Rs
+    ThumbLsrReg, // LSR Rd, Rs
+    ThumbAsrReg, // ASR Rd, Rs
+    ThumbAdc,    // ADC Rd, Rm
+    ThumbSbc,    // SBC Rd, Rm
+    ThumbRor,    // ROR Rd, Rs
+    ThumbTst,    // TST Rn, Rm
+    ThumbNeg,    // NEG Rd, Rm (RSB Rd, Rm, #0)
+    ThumbCmpReg, // CMP Rn, Rm
+    ThumbCmn,    // CMN Rn, Rm
+    ThumbOrr,    // ORR Rd, Rm
+    ThumbMul,    // MUL Rd, Rm
+    ThumbBic,    // BIC Rd, Rm
+    ThumbMvn,    // MVN Rd, Rm
+
+    // High register operations (format: 010001 op Rm Rd)
+    ThumbAddHi,  // ADD Rd, Rm (no flags, high regs)
+    ThumbCmpHi,  // CMP Rn, Rm (high regs)
+    ThumbMovHi,  // MOV Rd, Rm (no flags, high regs)
+    ThumbBx,     // BX Rm
+    ThumbBlxReg, // BLX Rm
+
+    // Load/Store word (format: 0101xx0 Rm Rn Rd / 011xx imm5 Rn Rd)
+    ThumbLdrReg,  // LDR Rd, [Rn, Rm]
+    ThumbStrReg,  // STR Rd, [Rn, Rm]
+    ThumbLdrImm5, // LDR Rd, [Rn, #imm5*4]
+    ThumbStrImm5, // STR Rd, [Rn, #imm5*4]
+
+    // Load/Store byte (format: 0101xx1 Rm Rn Rd / 011xx imm5 Rn Rd)
+    ThumbLdrbReg,  // LDRB Rd, [Rn, Rm]
+    ThumbStrbReg,  // STRB Rd, [Rn, Rm]
+    ThumbLdrbImm5, // LDRB Rd, [Rn, #imm5]
+    ThumbStrbImm5, // STRB Rd, [Rn, #imm5]
+
+    // Load/Store halfword
+    ThumbLdrhReg,  // LDRH Rd, [Rn, Rm]
+    ThumbStrhReg,  // STRH Rd, [Rn, Rm]
+    ThumbLdrhImm5, // LDRH Rd, [Rn, #imm5*2]
+    ThumbStrhImm5, // STRH Rd, [Rn, #imm5*2]
+
+    // Signed load
+    ThumbLdrsb, // LDRSB Rd, [Rn, Rm]
+    ThumbLdrsh, // LDRSH Rd, [Rn, Rm]
+
+    // SP-relative load/store (format: 1001x Rd imm8)
+    ThumbLdrSp, // LDR Rd, [SP, #imm8*4]
+    ThumbStrSp, // STR Rd, [SP, #imm8*4]
+
+    // PC-relative load (format: 01001 Rd imm8)
+    ThumbLdrPc, // LDR Rd, [PC, #imm8*4]
+
+    // Add to SP/PC (format: 1010x Rd imm8)
+    ThumbAddPcImm, // ADD Rd, PC, #imm8*4 (ADR)
+    ThumbAddSpImm, // ADD Rd, SP, #imm8*4
+
+    // Adjust SP (format: 10110000x imm7)
+    ThumbAddSpImm7, // ADD SP, #imm7*4
+    ThumbSubSpImm7, // SUB SP, #imm7*4
+
+    // Push/Pop (format: 1011x10x reg_list)
+    ThumbPush, // PUSH {reg_list}
+    ThumbPop,  // POP {reg_list}
+
+    // Load/Store Multiple (format: 1100x Rn reg_list)
+    ThumbLdmia, // LDMIA Rn!, {reg_list}
+    ThumbStmia, // STMIA Rn!, {reg_list}
+
+    // Conditional branch (format: 1101 cond imm8)
+    ThumbBCond, // B<cond> label
+
+    // Unconditional branch (format: 11100 imm11)
+    ThumbB, // B label
+
+    // Software interrupt
+    ThumbSwi, // SWI imm8
+
+    // Sign/Zero extend (format: 10110010xx Rm Rd)
+    ThumbSxth, // SXTH Rd, Rm
+    ThumbSxtb, // SXTB Rd, Rm
+    ThumbUxth, // UXTH Rd, Rm
+    ThumbUxtb, // UXTB Rd, Rm
+
+    // Byte reversal (format: 10111010xx Rm Rd)
+    ThumbRev,   // REV Rd, Rm
+    ThumbRev16, // REV16 Rd, Rm
+    ThumbRevsh, // REVSH Rd, Rm
+
+    // =========================================================================
+    // Thumb32 opcodes (BL, VFP, etc.)
+    // =========================================================================
+    ThumbBl,     // BL label (Thumb32)
+    ThumbBlxImm, // BLX label (Thumb32)
+
+    // =========================================================================
+    // Fused instruction opcodes
+    // =========================================================================
+    // Common compare/test + branch sequences executed as a single dispatch.
+
+    FusedSubsBcc,        // SUBS Rd, Rn, #imm; B<cond>
+    FusedSubsRegBcc,     // SUBS Rd, Rn, Rm; B<cond>
+    FusedCmpBcc,         // CMP Rn, #imm; B<cond>
+    FusedCmpRegBcc,      // CMP Rn, Rm; B<cond>
+    FusedTstBcc,         // TST Rn, #imm; B<cond>
+    FusedTstRegBcc,      // TST Rn, Rm; B<cond>
+    FusedTeqBcc,         // TEQ Rn, #imm; B<cond>
+    FusedTeqRegBcc,      // TEQ Rn, Rm; B<cond>
+    ThumbFusedSubsBcc,   // SUBS Rd, #imm8; B<cond>
+    ThumbFusedCmpBcc,    // CMP Rn, #imm8; B<cond>
+    ThumbFusedCmpRegBcc, // CMP Rn, Rm; B<cond>
+    ThumbFusedTstBcc,    // TST Rn, Rm; B<cond> (Thumb TST is register-only)
+    FusedAddCmpBcc,      // ADD Rd, Rn, #imm; CMP Rd, Rm; B<cond> (iterator loops)
+
+    // =========================================================================
+    // Unrolled loop opcodes
+    // =========================================================================
+    // These execute multiple loop iterations inline without dispatch overhead.
+    // Only generated for hot blocks that are tight loops.
+
+    // Thumb: SUBS Rd, #imm8; BNE self (countdown loop)
+    ThumbUnrolledSubsLoop,
+
+    // ARM: SUBS Rd, Rn, #imm; BNE self (countdown loop)
+    ArmUnrolledSubsLoop,
+
+    // Thumb: CMP Rn, Rm; BNE self (spin loop / wait pattern)
+    ThumbUnrolledCmpLoop,
+
+    // Coprocessor (CP15)
+    Mrc, // MRC p15, ... (read CP15 register)
+    Mcr, // MCR p15, ... (write CP15 register)
+
+    // Exclusive load/store
+    Ldrex,  // LDREX Rd, [Rn]
+    Strex,  // STREX Rd, Rm, [Rn]
+    Ldrexb, // LDREXB
+    Strexb, // STREXB
+    Ldrexh, // LDREXH
+    Strexh, // STREXH
+    Ldrexd, // LDREXD Rt, Rt+1, [Rn]
+    Strexd, // STREXD Rd, Rm, Rm+1, [Rn]
+    Clrex,  // CLREX
+
+    // Doubleword load/store
+    Ldrd, // LDRD Rd, Rd+1, [Rn, #offset]
+    Strd, // STRD Rd, Rd+1, [Rn, #offset]
+
+    // Halfword multiplies (misc space; x/y half selectors in mul.flags)
+    Smulxy,  // SMUL<x><y> Rd, Rm, Rs
+    Smlaxy,  // SMLA<x><y> Rd, Rm, Rs, Rn (sets Q on accumulate overflow)
+    Smulwy,  // SMULW<y> Rd, Rm, Rs
+    Smlawy,  // SMLAW<y> Rd, Rm, Rs, Rn (sets Q on accumulate overflow)
+    Smlalxy, // SMLAL<x><y> RdLo, RdHi, Rm, Rs
+
+    // =========================================================================
+    // Decode-time specialized opcodes
+    // =========================================================================
+    // Imm-offset load/store: decode guarantees offset addressing mode,
+    // immediate offset, rd != 15, rn != 15 (generic opcodes keep the rest)
+    LdrImm,  // LDR Rd, [Rn, #imm]
+    StrImm,  // STR Rd, [Rn, #imm]
+    LdrBImm, // LDRB Rd, [Rn, #imm]
+    StrBImm, // STRB Rd, [Rn, #imm]
+    LdrHImm, // LDRH Rd, [Rn, #imm] (zero-extends, like LdrH)
+    StrHImm, // STRH Rd, [Rn, #imm]
+
+    // ARM BLX immediate (always switches ARM->Thumb); target, LR, and
+    // destination mode are decode-time constants. Blx keeps the register form.
+    BlxImm,
+
+    // =========================================================================
+    // PC-source elimination
+    // =========================================================================
+    // LDR literal: word load from an absolute address (ls.offset holds the
+    // absolute literal-pool address, precomputed at decode). rd==15 branches.
+    LdrLit,
+
+    // PC-setup prefix: materializes the pipeline-adjusted PC (imm32) into
+    // regs[15] and falls through to the next slot. Decode inserts it before the
+    // rare instructions that read R15 as a source and cannot be folded to a
+    // constant, so the dispatch loop never has to keep regs[15] current.
+    // inst_size and ticks are 0 (the following real instruction carries both).
+    PcSetup,
+
+    OpcodeCount
+};
+
+// ============================================================================
+// Pre-decoded Instruction Representation
+// ============================================================================
+// Operands are extracted at decode time so handlers never re-parse encodings.
+
+/// Shift type for barrel shifter operations
+enum class ShiftType : u8 {
+    LSL = 0, // Logical shift left
+    LSR = 1, // Logical shift right
+    ASR = 2, // Arithmetic shift right
+    ROR = 3, // Rotate right (includes RRX when amount is 0)
+};
+
+/// Addressing mode for load/store
+enum class AddrMode : u8 {
+    Offset,    // [Rn, #offset]
+    PreIndex,  // [Rn, #offset]!
+    PostIndex, // [Rn], #offset
+};
+
+/// Pre-decoded instruction
+struct DecodedInst {
+    Opcode opcode; // 2 bytes
+    u8 cond;       // 1 byte: Condition code (0-14, 15=unconditional)
+    u8 rd;         // 1 byte: Destination register
+
+    union {
+        // Data processing format
+        struct {
+            u8 rn;                // First source register
+            u8 rm;                // Second source register (0xFF = immediate operand)
+            u8 rs;                // Shift amount register (0xFF = immediate shift)
+            ShiftType shift_type; // Type of shift
+            u8 shift_imm;         // Immediate shift amount (0-31)
+            u8 flags;             // Bit flags for variants
+            u32 imm;              // Immediate value (already rotated)
+        } dp;
+
+        // Multiply format
+        struct {
+            u8 rn;    // Accumulator register (for MLA, etc.)
+            u8 rm;    // First multiply operand
+            u8 rs;    // Second multiply operand
+            u8 rdhi;  // High destination (for long multiply)
+            u8 flags; // Halfword multiplies: bit0 = x (Rm half), bit1 = y (Rs half)
+        } mul;
+
+        // Load/Store format
+        struct {
+            u8 rn;                // Base register
+            u8 rm;                // Index register (0xFF = immediate offset)
+            AddrMode mode;        // Addressing mode
+            ShiftType shift_type; // Shift for register offset
+            u8 shift_imm;         // Shift amount
+            u8 flags;             // U (add/sub), W (writeback), etc.
+            u8 rt2;               // Second transfer register (Ldrd/Strd only;
+                                  // rd+1 in ARM, independent Rt2 in Thumb32)
+            s32 offset;           // Immediate offset (signed, already computed)
+        } ls;
+
+        // Load/Store Multiple format
+        struct {
+            u8 rn;        // Base register
+            u8 count;     // Popcount of reg_list (precomputed at decode)
+            u16 reg_list; // Bitmask of registers
+            u8 flags;     // P,U,S,W bits
+            s8 base_off;  // Base-to-first-access offset (folds increment/before)
+            s16 wb_delta; // Writeback delta: +count*4 or -count*4
+        } lsm;
+
+        // Branch format
+        struct {
+            u32 target; // Absolute branch target (precomputed at decode)
+            u8 rm;      // Register for BX/BLX reg; BlxImm: destination T bit
+            u32 lr;     // Link-register value (precomputed for Bl/BlxImm/
+                        // ThumbBl/ThumbBlxImm)
+        } branch;
+
+        // VFP format
+        struct {
+            u8 sd;      // Destination S/D register (0-31 for S, 0-15 for D)
+            u8 sn;      // First source register
+            u8 sm;      // Second source register
+            u8 rt;      // ARM register for transfers
+            u8 rt2;     // Second ARM register (for double transfers)
+            u8 rn;      // Base register for load/store
+            s16 offset; // Load/store offset (in bytes)
+            u8 flags;   // Bit 0: unsigned (for VCVT), Bit 1: to_integer, etc.
+        } vfp;
+
+        // VFP immediate format (VmovImmS/D): fully expanded modified-immediate
+        // constant precomputed at decode
+        struct {
+            u8 sd;  // Destination register (same byte slot as vfp.sd)
+            u32 lo; // F32 bits / low word of F64 bits
+            u32 hi; // High word of F64 bits (VmovImmD only)
+        } vimm;
+
+        // Fused instruction format
+        // Combines ALU operation + conditional branch into single handler
+        struct {
+            u8 rn; // First operand register (for SUBS/CMP)
+            u8 rm; // Second operand register (0xFF=imm no rotation, 0xFE=imm with rotation)
+            u8 branch_cond;    // Condition for the branch (0=EQ, 1=NE, etc.)
+            u8 combined_size;  // Total size of fused instructions in bytes
+            u32 imm;           // Immediate operand (for SUBS Rd,Rn,#imm or CMP Rn,#imm)
+            u32 branch_target; // Absolute taken-branch target (precomputed at decode)
+        } fused;
+
+        // Generic 32-bit immediate
+        u32 imm32;
+    };
+
+    // Size in bytes of original instruction (4 for ARM, 2 or 4 for Thumb)
+    u8 inst_size;
+
+    // Tick cost for this instruction (matches Dynarmic's variable tick model)
+    u8 ticks;
+};
+
+static_assert(sizeof(DecodedInst) == 20, "DecodedInst should be 20 bytes");
+
+// ============================================================================
+// Basic Block Structure
+// ============================================================================
+
+/// Maximum instruction slots per block: 31 real instructions + 1 reserved for
+/// the EndBlock terminator every block carries (DISPATCH has no bounds check).
+/// Most game blocks are 5-15 instructions; 31 handles 95%+ of blocks
+constexpr size_t MAX_BLOCK_SIZE = 32;
+
+/// Block flags
+constexpr u16 BLOCK_FLAG_THUMB = 0x01;       // Block contains Thumb code
+constexpr u16 BLOCK_FLAG_HOT = 0x02;         // Block has been marked as hot
+constexpr u16 BLOCK_FLAG_REOPTIMIZED = 0x04; // Block has been reoptimized
+
+/// Threshold for considering a block "hot" (frequently executed)
+constexpr u32 HOT_BLOCK_THRESHOLD = 1000;
+
+/// Basic block of decoded instructions
+struct BasicBlock {
+    u32 start_pc;   // Starting PC of this block
+    u32 end_pc;     // Ending PC (exclusive)
+    u16 inst_count; // Number of real instructions (the EndBlock terminator at
+                    // instructions[inst_count] is not counted)
+    u16 flags;      // Block flags
+
+    // Execution counter for hot path detection
+    u32 exec_count;
+
+    // Chain target for block chaining (kept in the header so the chain fast
+    // path and the other hot header fields share a cache line)
+    BasicBlock* chain_target; // Next block for chaining
+
+    // Decoded instructions (inline for cache locality)
+    std::array<DecodedInst, MAX_BLOCK_SIZE> instructions;
+
+    bool IsThumb() const {
+        return flags & BLOCK_FLAG_THUMB;
+    }
+    void SetThumb(bool thumb) {
+        flags = (flags & ~BLOCK_FLAG_THUMB) | (thumb ? BLOCK_FLAG_THUMB : 0);
+    }
+    bool IsHot() const {
+        return flags & BLOCK_FLAG_HOT;
+    }
+    void SetHot() {
+        flags |= BLOCK_FLAG_HOT;
+    }
+    bool IsReoptimized() const {
+        return flags & BLOCK_FLAG_REOPTIMIZED;
+    }
+    void SetReoptimized() {
+        flags |= BLOCK_FLAG_REOPTIMIZED;
+    }
+};
+
+// ============================================================================
+// Fusion Statistics
+// ============================================================================
+// Tracks fusion opportunities and hit rates for performance analysis.
+
+struct FusionStats {
+    u64 blocks_decoded{0};         // Total blocks decoded
+    u64 fusions_attempted{0};      // Fusion opportunities detected
+    u64 fusions_applied{0};        // Fusions actually applied
+    u64 hot_blocks_detected{0};    // Blocks that exceeded hot threshold
+    u64 hot_blocks_reoptimized{0}; // Blocks that were reoptimized after becoming hot
+    u64 dead_flags_eliminated{0};  // Flag-setters downgraded to non-flag-setting forms
+
+    // Per-pattern fusion counts
+    u64 subs_bcc_fusions{0};    // SUBS + Bcc fusions
+    u64 cmp_bcc_fusions{0};     // CMP + Bcc fusions
+    u64 tst_bcc_fusions{0};     // TST + Bcc fusions
+    u64 teq_bcc_fusions{0};     // TEQ + Bcc fusions
+    u64 add_cmp_bcc_fusions{0}; // ADD + CMP + Bcc fusions
+    u64 thumb_fusions{0};       // All Thumb fusions
+
+    void Reset() {
+        blocks_decoded = 0;
+        fusions_attempted = 0;
+        fusions_applied = 0;
+        hot_blocks_detected = 0;
+        hot_blocks_reoptimized = 0;
+        dead_flags_eliminated = 0;
+        subs_bcc_fusions = 0;
+        cmp_bcc_fusions = 0;
+        tst_bcc_fusions = 0;
+        teq_bcc_fusions = 0;
+        add_cmp_bcc_fusions = 0;
+        thumb_fusions = 0;
+    }
+};
+
+// ============================================================================
+// Interpreter State
+// ============================================================================
+// This structure holds all CPU state, optimized for cache locality.
+// Hot fields (registers, PC, flags) are placed first.
+
+/// Page table constants (duplicated here to avoid including memory.h)
+constexpr int FASTINTERP_PAGE_BITS = 12;
+constexpr u32 FASTINTERP_PAGE_MASK = (1 << FASTINTERP_PAGE_BITS) - 1;
+
+struct InterpreterState {
+    // Hot path: Guest registers (64 bytes - fits in one cache line)
+    std::array<u32, 16> regs; // R0-R15 (R15 = PC)
+
+    // Raw pointer array of the current PageTable, or the all-null
+    // empty_page_table (fastinterp.cpp) when no table is set. Never null, so
+    // the memory fast paths only test the per-page entry.
+    u8** page_pointers{nullptr};
+
+    // Lazy flags (separate from CPSR for fast access)
+    LazyFlags lazy_flags;
+
+    // CPSR (non-flag bits: mode, interrupt masks, etc.)
+    u32 cpsr_other; // CPSR without NZCV flags
+
+    // VFP registers (256 bytes)
+    std::array<u32, 64> vfp_regs; // D0-D31 as 32-bit halves
+    u32 fpscr;
+    u32 fpexc;
+
+    // CP15 registers
+    u32 cp15_thread_uprw;
+    u32 cp15_thread_uro;
+
+    // Execution state
+    bool thumb_mode;
+
+    // Helper to get/set PC
+    u32 PC() const {
+        return regs[15];
+    }
+    void SetPC(u32 pc) {
+        regs[15] = pc;
+    }
+
+    // Build full CPSR from lazy flags and other bits
+    u32 GetCPSR() {
+        u32 cpsr = lazy_flags.GetPacked() | (cpsr_other & 0x0FFFFFFF);
+        // Sync T bit from thumb_mode (branch handlers update thumb_mode
+        // but not cpsr_other, so we must merge here)
+        cpsr = (cpsr & ~(1u << 5)) | (static_cast<u32>(thumb_mode) << 5);
+        return cpsr;
+    }
+
+    // Set CPSR (splits into flags and other)
+    void SetCPSR(u32 cpsr) {
+        lazy_flags.SetPacked(cpsr);
+        cpsr_other = cpsr & 0x0FFFFFFF;
+    }
+};
+
+} // namespace Core::FastInterp
diff --git a/src/core/arm/fastinterp/handlers/arm_alu.inc b/src/core/arm/fastinterp/handlers/arm_alu.inc
new file mode 100644
index 0000000..85cebbf
--- /dev/null
+++ b/src/core/arm/fastinterp/handlers/arm_alu.inc
@@ -0,0 +1,180 @@
+// Copyright 2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// ARM ALU handlers, non-S-variant: And, Eor, Sub, Rsb, Add, Adc, Sbc, Rsc, Orr,
+//     Mov, Bic, Mvn (no flag updates), plus the Tst, Teq, Cmp, Cmn compares
+//     (which have no non-S form and always update flags)
+
+// When an ALU instruction writes to PC (R15), treat as a branch
+#define ALU_DISPATCH() do { \
+    if (__builtin_expect(inst->rd == 15, 0)) { \
+        u32 new_pc = state_.regs[15]; \
+        state_.thumb_mode = new_pc & 1; \
+        SET_PC(new_pc & ~1u); \
+        executed += inst->ticks; \
+        goto chain; \
+    } \
+    ADVANCE_AND_DISPATCH(); \
+} while(0)
+
+handle_And: {
+    CHECK_COND();
+    u32 op2 = GetOp2Fast();
+    state_.regs[inst->rd] = state_.regs[inst->dp.rn] & op2;
+    ALU_DISPATCH();
+}
+
+handle_Eor: {
+    CHECK_COND();
+    u32 op2 = GetOp2Fast();
+    state_.regs[inst->rd] = state_.regs[inst->dp.rn] ^ op2;
+    ALU_DISPATCH();
+}
+
+handle_Sub: {
+    CHECK_COND();
+    u32 op2 = GetOp2Fast();
+    state_.regs[inst->rd] = state_.regs[inst->dp.rn] - op2;
+    ALU_DISPATCH();
+}
+
+handle_Rsb: {
+    CHECK_COND();
+    u32 op2 = GetOp2Fast();
+    state_.regs[inst->rd] = op2 - state_.regs[inst->dp.rn];
+    ALU_DISPATCH();
+}
+
+handle_Add: {
+    CHECK_COND();
+    u32 op2 = GetOp2Fast();
+    state_.regs[inst->rd] = state_.regs[inst->dp.rn] + op2;
+    ALU_DISPATCH();
+}
+
+handle_Adc: {
+    CHECK_COND();
+    u32 op2 = GetOp2Fast();
+    u32 c = state_.lazy_flags.GetC() ? 1 : 0;
+    state_.regs[inst->rd] = state_.regs[inst->dp.rn] + op2 + c;
+    ALU_DISPATCH();
+}
+
+handle_Sbc: {
+    CHECK_COND();
+    u32 op2 = GetOp2Fast();
+    u32 c = state_.lazy_flags.GetC() ? 1 : 0;
+    state_.regs[inst->rd] = state_.regs[inst->dp.rn] - op2 - (1 - c);
+    ALU_DISPATCH();
+}
+
+handle_Rsc: {
+    CHECK_COND();
+    u32 op2 = GetOp2Fast();
+    u32 c = state_.lazy_flags.GetC() ? 1 : 0;
+    state_.regs[inst->rd] = op2 - state_.regs[inst->dp.rn] - (1 - c);
+    ALU_DISPATCH();
+}
+
+handle_Tst: {
+    CHECK_COND();
+    const u32 old_nzcv = state_.lazy_flags.GetPacked();
+    bool carry = (old_nzcv >> 29) & 1;
+    u32 op2 = GetOp2(carry);
+    u32 op1 = state_.regs[inst->dp.rn];
+#ifdef __aarch64__
+    u32 nzcv;
+    ARM64_TST(op1, op2, nzcv, ARM64_CV_SHIFTER(carry, old_nzcv));
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 & op2;
+    state_.lazy_flags.op = FlagOp::And;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.shifter_carry = carry ? 1 : 0;
+#endif
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Teq: {
+    CHECK_COND();
+    const u32 old_nzcv = state_.lazy_flags.GetPacked();
+    bool carry = (old_nzcv >> 29) & 1;
+    u32 op2 = GetOp2(carry);
+    u32 op1 = state_.regs[inst->dp.rn];
+#ifdef __aarch64__
+    u32 nzcv;
+    ARM64_TEQ(op1, op2, nzcv, ARM64_CV_SHIFTER(carry, old_nzcv));
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 ^ op2;
+    state_.lazy_flags.op = FlagOp::Eor;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.shifter_carry = carry ? 1 : 0;
+#endif
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Cmp: {
+    CHECK_COND();
+    u32 op1 = state_.regs[inst->dp.rn];
+    u32 op2 = GetOp2Fast();
+#ifdef __aarch64__
+    u32 nzcv;
+    ARM64_CMP(op1, op2, nzcv);
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 - op2;
+    state_.lazy_flags.op = FlagOp::Cmp;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = op2;
+#endif
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Cmn: {
+    CHECK_COND();
+    u32 op1 = state_.regs[inst->dp.rn];
+    u32 op2 = GetOp2Fast();
+#ifdef __aarch64__
+    u32 nzcv;
+    ARM64_CMN(op1, op2, nzcv);
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 + op2;
+    state_.lazy_flags.op = FlagOp::Cmn;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = op2;
+#endif
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Orr: {
+    CHECK_COND();
+    u32 op2 = GetOp2Fast();
+    state_.regs[inst->rd] = state_.regs[inst->dp.rn] | op2;
+    ALU_DISPATCH();
+}
+
+handle_Mov: {
+    CHECK_COND();
+    u32 op2 = GetOp2Fast();
+    state_.regs[inst->rd] = op2;
+    ALU_DISPATCH();
+}
+
+handle_Bic: {
+    CHECK_COND();
+    u32 op2 = GetOp2Fast();
+    state_.regs[inst->rd] = state_.regs[inst->dp.rn] & ~op2;
+    ALU_DISPATCH();
+}
+
+handle_Mvn: {
+    CHECK_COND();
+    u32 op2 = GetOp2Fast();
+    state_.regs[inst->rd] = ~op2;
+    ALU_DISPATCH();
+}
diff --git a/src/core/arm/fastinterp/handlers/arm_alu_s.inc b/src/core/arm/fastinterp/handlers/arm_alu_s.inc
new file mode 100644
index 0000000..a475881
--- /dev/null
+++ b/src/core/arm/fastinterp/handlers/arm_alu_s.inc
@@ -0,0 +1,257 @@
+// Copyright 2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// ARM ALU S-variant handlers: AndS, EorS, SubS, RsbS, AddS, AdcS, SbcS,
+//                             RscS, OrrS, MovS, BicS, MvnS
+
+// Note: ALU_DISPATCH() macro defined in arm_alu.inc handles Rd=15 branch
+
+handle_AndS: {
+    CHECK_COND();
+    const u32 old_nzcv = state_.lazy_flags.GetPacked();
+    bool carry = (old_nzcv >> 29) & 1;
+    u32 op2 = GetOp2(carry);
+    u32 op1 = state_.regs[inst->dp.rn];
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_ANDS(result, op1, op2, nzcv, ARM64_CV_SHIFTER(carry, old_nzcv));
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 & op2;
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.op = FlagOp::And;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.shifter_carry = carry ? 1 : 0;
+#endif
+    ALU_DISPATCH();
+}
+
+handle_EorS: {
+    CHECK_COND();
+    const u32 old_nzcv = state_.lazy_flags.GetPacked();
+    bool carry = (old_nzcv >> 29) & 1;
+    u32 op2 = GetOp2(carry);
+    u32 op1 = state_.regs[inst->dp.rn];
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_EORS(result, op1, op2, nzcv, ARM64_CV_SHIFTER(carry, old_nzcv));
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 ^ op2;
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.op = FlagOp::Eor;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.shifter_carry = carry ? 1 : 0;
+#endif
+    ALU_DISPATCH();
+}
+
+handle_SubS: {
+    CHECK_COND();
+    u32 op1 = state_.regs[inst->dp.rn];
+    u32 op2 = GetOp2Fast();
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_SUBS(result, op1, op2, nzcv);
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 - op2;
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.op = FlagOp::Sub;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = op2;
+#endif
+    ALU_DISPATCH();
+}
+
+handle_RsbS: {
+    CHECK_COND();
+    u32 op1 = state_.regs[inst->dp.rn];
+    u32 op2 = GetOp2Fast();
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_SUBS(result, op2, op1, nzcv);
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op2 - op1;
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.op = FlagOp::Rsb;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = op2;
+#endif
+    ALU_DISPATCH();
+}
+
+handle_AddS: {
+    CHECK_COND();
+    u32 op1 = state_.regs[inst->dp.rn];
+    u32 op2 = GetOp2Fast();
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_ADDS(result, op1, op2, nzcv);
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 + op2;
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.op = FlagOp::Add;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = op2;
+#endif
+    ALU_DISPATCH();
+}
+
+handle_AdcS: {
+    CHECK_COND();
+    u32 op1 = state_.regs[inst->dp.rn];
+    u32 op2 = GetOp2Fast();
+    u32 c = state_.lazy_flags.GetC() ? 1 : 0;
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_ADCS(result, op1, op2, c, nzcv);
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 + op2 + c;
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.op = FlagOp::Adc;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = op2;
+    state_.lazy_flags.shifter_carry = c;
+#endif
+    ALU_DISPATCH();
+}
+
+handle_SbcS: {
+    CHECK_COND();
+    u32 op1 = state_.regs[inst->dp.rn];
+    u32 op2 = GetOp2Fast();
+    u32 c = state_.lazy_flags.GetC() ? 1 : 0;
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_SBCS(result, op1, op2, c, nzcv);
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 - op2 - (1 - c);
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.op = FlagOp::Sbc;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = op2;
+    state_.lazy_flags.shifter_carry = c;
+#endif
+    ALU_DISPATCH();
+}
+
+handle_RscS: {
+    CHECK_COND();
+    u32 op1 = state_.regs[inst->dp.rn];
+    u32 op2 = GetOp2Fast();
+    u32 c = state_.lazy_flags.GetC() ? 1 : 0;
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_RSCS(result, op1, op2, c, nzcv);
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op2 - op1 - (1 - c);
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.op = FlagOp::Rsc;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.operand1 = op1;
+    state_.lazy_flags.operand2 = op2;
+    state_.lazy_flags.shifter_carry = c;
+#endif
+    ALU_DISPATCH();
+}
+
+handle_OrrS: {
+    CHECK_COND();
+    const u32 old_nzcv = state_.lazy_flags.GetPacked();
+    bool carry = (old_nzcv >> 29) & 1;
+    u32 op2 = GetOp2(carry);
+    u32 op1 = state_.regs[inst->dp.rn];
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_ORRS(result, op1, op2, nzcv, ARM64_CV_SHIFTER(carry, old_nzcv));
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 | op2;
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.op = FlagOp::Orr;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.shifter_carry = carry ? 1 : 0;
+#endif
+    ALU_DISPATCH();
+}
+
+handle_MovS: {
+    CHECK_COND();
+    const u32 old_nzcv = state_.lazy_flags.GetPacked();
+    bool carry = (old_nzcv >> 29) & 1;
+    u32 op2 = GetOp2(carry);
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_MOVS(result, op2, nzcv, ARM64_CV_SHIFTER(carry, old_nzcv));
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    state_.regs[inst->rd] = op2;
+    state_.lazy_flags.op = FlagOp::Mov;
+    state_.lazy_flags.result = op2;
+    state_.lazy_flags.shifter_carry = carry ? 1 : 0;
+#endif
+    ALU_DISPATCH();
+}
+
+handle_BicS: {
+    CHECK_COND();
+    const u32 old_nzcv = state_.lazy_flags.GetPacked();
+    bool carry = (old_nzcv >> 29) & 1;
+    u32 op2 = GetOp2(carry);
+    u32 op1 = state_.regs[inst->dp.rn];
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_BICS(result, op1, op2, nzcv, ARM64_CV_SHIFTER(carry, old_nzcv));
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = op1 & ~op2;
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.op = FlagOp::Bic;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.shifter_carry = carry ? 1 : 0;
+#endif
+    ALU_DISPATCH();
+}
+
+handle_MvnS: {
+    CHECK_COND();
+    const u32 old_nzcv = state_.lazy_flags.GetPacked();
+    bool carry = (old_nzcv >> 29) & 1;
+    u32 op2 = GetOp2(carry);
+#ifdef __aarch64__
+    u32 result, nzcv;
+    ARM64_MVNS(result, op2, nzcv, ARM64_CV_SHIFTER(carry, old_nzcv));
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.SetPacked(nzcv);
+#else
+    u32 result = ~op2;
+    state_.regs[inst->rd] = result;
+    state_.lazy_flags.op = FlagOp::Mvn;
+    state_.lazy_flags.result = result;
+    state_.lazy_flags.shifter_carry = carry ? 1 : 0;
+#endif
+    ALU_DISPATCH();
+}
diff --git a/src/core/arm/fastinterp/handlers/arm_branch.inc b/src/core/arm/fastinterp/handlers/arm_branch.inc
new file mode 100644
index 0000000..cc1c627
--- /dev/null
+++ b/src/core/arm/fastinterp/handlers/arm_branch.inc
@@ -0,0 +1,51 @@
+// Copyright 2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// ARM Branch handlers: B, Bl, Bx, Blx, BlxImm
+
+handle_B: {
+    CHECK_COND();
+    SET_PC(inst->branch.target); // Absolute target precomputed at decode
+    executed += inst->ticks;
+    goto chain;
+}
+
+handle_Bl: {
+    CHECK_COND();
+    state_.regs[14] = inst->branch.lr; // Precomputed at decode
+    SET_PC(inst->branch.target);
+    executed += inst->ticks;
+    goto chain;
+}
+
+handle_Bx: {
+    CHECK_COND();
+    u32 target = state_.regs[inst->branch.rm];
+    state_.thumb_mode = (target & 1) != 0;
+    SET_PC(target & ~1u);
+    executed += inst->ticks;
+    goto chain;
+}
+
+handle_Blx: {
+    CHECK_COND();
+    // BLX register (immediate form is BlxImm); this is the ARM encoding, so
+    // the block is ARM mode (Thumb BLX is ThumbBlxReg)
+    state_.regs[14] = GET_PC() + 4;
+    u32 target = state_.regs[inst->branch.rm];
+    state_.thumb_mode = (target & 1) != 0;
+    SET_PC(target & ~1u);
+    executed += inst->ticks;
+    goto chain;
+}
+
+handle_BlxImm: {
+    CHECK_COND();
+    // ARM BLX immediate: target, LR, and destination mode precomputed at decode
+    state_.regs[14] = inst->branch.lr;
+    state_.thumb_mode = inst->branch.rm != 0;
+    SET_PC(inst->branch.target);
+    executed += inst->ticks;
+    goto chain;
+}
diff --git a/src/core/arm/fastinterp/handlers/arm_loadstore.inc b/src/core/arm/fastinterp/handlers/arm_loadstore.inc
new file mode 100644
index 0000000..596c632
--- /dev/null
+++ b/src/core/arm/fastinterp/handlers/arm_loadstore.inc
@@ -0,0 +1,496 @@
+// Copyright 2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// ARM Load/Store handlers: register/scaled-offset (Ldr, LdrB, LdrH, LdrSB,
+//     LdrSH, Str, StrB, StrH), immediate-offset fast paths (LdrImm, StrImm,
+//     LdrBImm, StrBImm, LdrHImm, StrHImm), PC-relative literal (LdrLit),
+//     doubleword (Ldrd, Strd), and block transfer (Ldm, Stm)
+
+handle_Ldr: {
+    CHECK_COND();
+    // rn==15 is only reachable behind a PcSetup prefix (regs[15] = pipeline
+    // PC): word literals fold to LdrLit at decode, and the Thumb byte/half
+    // literal alignment is baked into the decoded offset.
+    u32 addr = state_.regs[inst->ls.rn];
+    s32 offset = inst->ls.offset;
+    if (inst->ls.rm != 0xFF) {
+        offset = static_cast<s32>(ShiftNoCarry(state_.regs[inst->ls.rm], inst->ls.shift_type,
+                                                inst->ls.shift_imm));
+        if (!(inst->ls.flags & 0x01)) {
+            offset = -offset; // U==0 => subtract register offset
+        }
+    }
+
+    u32 effective_addr;
+    switch (inst->ls.mode) {
+    case AddrMode::Offset:
+        effective_addr = addr + offset;
+        break;
+    case AddrMode::PreIndex:
+        effective_addr = addr + offset;
+        state_.regs[inst->ls.rn] = effective_addr;
+        break;
+    case AddrMode::PostIndex:
+        effective_addr = addr;
+        state_.regs[inst->ls.rn] = addr + offset;
+        break;
+    }
+
+    state_.regs[inst->rd] = MemRead32(effective_addr);
+    executed += inst->ticks;
+
+    // If destination is PC, it's a branch
+    if (inst->rd == 15) {
+        u32 new_pc = state_.regs[15];
+        state_.thumb_mode = new_pc & 1;
+        SET_PC(new_pc & ~1u);
+        goto chain;
+    }
+
+    SET_PC(GET_PC() + inst->inst_size);
+    DISPATCH();
+}
+
+handle_LdrB: {
+    CHECK_COND();
+    u32 addr = state_.regs[inst->ls.rn];
+    s32 offset = inst->ls.offset;
+    if (inst->ls.rm != 0xFF) {
+        offset = static_cast<s32>(ShiftNoCarry(state_.regs[inst->ls.rm], inst->ls.shift_type,
+                                                inst->ls.shift_imm));
+        if (!(inst->ls.flags & 0x01)) {
+            offset = -offset; // U==0 => subtract register offset
+        }
+    }
+
+    u32 effective_addr;
+    switch (inst->ls.mode) {
+    case AddrMode::Offset:
+        effective_addr = addr + offset;
+        break;
+    case AddrMode::PreIndex:
+        effective_addr = addr + offset;
+        state_.regs[inst->ls.rn] = effective_addr;
+        break;
+    case AddrMode::PostIndex:
+        effective_addr = addr;
+        state_.regs[inst->ls.rn] = addr + offset;
+        break;
+    }
+
+    state_.regs[inst->rd] = MemRead8(effective_addr);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_LdrH: {
+    CHECK_COND();
+    u32 addr = state_.regs[inst->ls.rn];
+    s32 offset = inst->ls.offset;
+    if (inst->ls.rm != 0xFF) {
+        offset = static_cast<s32>(state_.regs[inst->ls.rm]);
+        if (!(inst->ls.flags & 0x01)) {
+            offset = -offset; // U==0 => subtract register offset
+        }
+    }
+
+    u32 effective_addr;
+    switch (inst->ls.mode) {
+    case AddrMode::Offset:
+        effective_addr = addr + offset;
+        break;
+    case AddrMode::PreIndex:
+        effective_addr = addr + offset;
+        state_.regs[inst->ls.rn] = effective_addr;
+        break;
+    case AddrMode::PostIndex:
+        effective_addr = addr;
+        state_.regs[inst->ls.rn] = addr + offset;
+        break;
+    }
+
+    state_.regs[inst->rd] = MemRead16(effective_addr);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_LdrSB: {
+    CHECK_COND();
+    u32 addr = state_.regs[inst->ls.rn];
+    s32 offset = inst->ls.offset;
+    if (inst->ls.rm != 0xFF) {
+        offset = static_cast<s32>(state_.regs[inst->ls.rm]);
+        if (!(inst->ls.flags & 0x01)) {
+            offset = -offset; // U==0 => subtract register offset
+        }
+    }
+
+    u32 effective_addr;
+    switch (inst->ls.mode) {
+    case AddrMode::Offset:
+        effective_addr = addr + offset;
+        break;
+    case AddrMode::PreIndex:
+        effective_addr = addr + offset;
+        state_.regs[inst->ls.rn] = effective_addr;
+        break;
+    case AddrMode::PostIndex:
+        effective_addr = addr;
+        state_.regs[inst->ls.rn] = addr + offset;
+        break;
+    }
+
+    state_.regs[inst->rd] = static_cast<u32>(static_cast<s8>(MemRead8(effective_addr)));
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_LdrSH: {
+    CHECK_COND();
+    u32 addr = state_.regs[inst->ls.rn];
+    s32 offset = inst->ls.offset;
+    if (inst->ls.rm != 0xFF) {
+        offset = static_cast<s32>(state_.regs[inst->ls.rm]);
+        if (!(inst->ls.flags & 0x01)) {
+            offset = -offset; // U==0 => subtract register offset
+        }
+    }
+
+    u32 effective_addr;
+    switch (inst->ls.mode) {
+    case AddrMode::Offset:
+        effective_addr = addr + offset;
+        break;
+    case AddrMode::PreIndex:
+        effective_addr = addr + offset;
+        state_.regs[inst->ls.rn] = effective_addr;
+        break;
+    case AddrMode::PostIndex:
+        effective_addr = addr;
+        state_.regs[inst->ls.rn] = addr + offset;
+        break;
+    }
+
+    state_.regs[inst->rd] = static_cast<u32>(static_cast<s16>(MemRead16(effective_addr)));
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Str: {
+    CHECK_COND();
+    u32 addr = state_.regs[inst->ls.rn];
+    s32 offset = inst->ls.offset;
+    if (inst->ls.rm != 0xFF) {
+        offset = static_cast<s32>(ShiftNoCarry(state_.regs[inst->ls.rm], inst->ls.shift_type,
+                                                inst->ls.shift_imm));
+        if (!(inst->ls.flags & 0x01)) {
+            offset = -offset; // U==0 => subtract register offset
+        }
+    }
+
+    u32 effective_addr;
+    switch (inst->ls.mode) {
+    case AddrMode::Offset:
+        effective_addr = addr + offset;
+        break;
+    case AddrMode::PreIndex:
+        effective_addr = addr + offset;
+        state_.regs[inst->ls.rn] = effective_addr;
+        break;
+    case AddrMode::PostIndex:
+        effective_addr = addr;
+        state_.regs[inst->ls.rn] = addr + offset;
+        break;
+    }
+
+    MemWrite32(effective_addr, state_.regs[inst->rd]);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_StrB: {
+    CHECK_COND();
+    u32 addr = state_.regs[inst->ls.rn];
+    s32 offset = inst->ls.offset;
+    if (inst->ls.rm != 0xFF) {
+        offset = static_cast<s32>(ShiftNoCarry(state_.regs[inst->ls.rm], inst->ls.shift_type,
+                                                inst->ls.shift_imm));
+        if (!(inst->ls.flags & 0x01)) {
+            offset = -offset; // U==0 => subtract register offset
+        }
+    }
+
+    u32 effective_addr;
+    switch (inst->ls.mode) {
+    case AddrMode::Offset:
+        effective_addr = addr + offset;
+        break;
+    case AddrMode::PreIndex:
+        effective_addr = addr + offset;
+        state_.regs[inst->ls.rn] = effective_addr;
+        break;
+    case AddrMode::PostIndex:
+        effective_addr = addr;
+        state_.regs[inst->ls.rn] = addr + offset;
+        break;
+    }
+
+    MemWrite8(effective_addr, static_cast<u8>(state_.regs[inst->rd]));
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_StrH: {
+    CHECK_COND();
+    u32 addr = state_.regs[inst->ls.rn];
+    s32 offset = inst->ls.offset;
+    if (inst->ls.rm != 0xFF) {
+        offset = static_cast<s32>(state_.regs[inst->ls.rm]);
+        if (!(inst->ls.flags & 0x01)) {
+            offset = -offset; // U==0 => subtract register offset
+        }
+    }
+
+    u32 effective_addr;
+    switch (inst->ls.mode) {
+    case AddrMode::Offset:
+        effective_addr = addr + offset;
+        break;
+    case AddrMode::PreIndex:
+        effective_addr = addr + offset;
+        state_.regs[inst->ls.rn] = effective_addr;
+        break;
+    case AddrMode::PostIndex:
+        effective_addr = addr;
+        state_.regs[inst->ls.rn] = addr + offset;
+        break;
+    }
+
+    MemWrite16(effective_addr, static_cast<u16>(state_.regs[inst->rd]));
+    ADVANCE_AND_DISPATCH();
+}
+
+// Specialized immediate-offset load/store (decode guarantees: offset mode,
+// immediate offset, rd != 15, rn != 15)
+
+handle_LdrImm: {
+    CHECK_COND();
+    MEM_READ32(state_.regs[inst->ls.rn] + inst->ls.offset, state_.regs[inst->rd]);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_StrImm: {
+    CHECK_COND();
+    MEM_WRITE32(state_.regs[inst->ls.rn] + inst->ls.offset, state_.regs[inst->rd]);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_LdrBImm: {
+    CHECK_COND();
+    MEM_READ8(state_.regs[inst->ls.rn] + inst->ls.offset, state_.regs[inst->rd]);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_StrBImm: {
+    CHECK_COND();
+    MEM_WRITE8(state_.regs[inst->ls.rn] + inst->ls.offset, state_.regs[inst->rd]);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_LdrHImm: {
+    CHECK_COND();
+    u16 val;
+    MEM_READ16(state_.regs[inst->ls.rn] + inst->ls.offset, val);
+    state_.regs[inst->rd] = val; // zero-extend (matches generic LdrH)
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_StrHImm: {
+    CHECK_COND();
+    MEM_WRITE16(state_.regs[inst->ls.rn] + inst->ls.offset, state_.regs[inst->rd]);
+    ADVANCE_AND_DISPATCH();
+}
+
+// LDR literal: ls.offset holds the absolute literal-pool address,
+// precomputed at decode from the pipeline-adjusted PC. rd==15 is a branch
+// (ARM jump tables use LDR PC, [PC, #imm]).
+handle_LdrLit: {
+    CHECK_COND();
+    u32 value;
+    MEM_READ32(static_cast<u32>(inst->ls.offset), value);
+    state_.regs[inst->rd] = value;
+    executed += inst->ticks;
+    if (inst->rd == 15) {
+        state_.thumb_mode = value & 1;
+        SET_PC(value & ~1u);
+        goto chain;
+    }
+    SET_PC(GET_PC() + inst->inst_size);
+    DISPATCH();
+}
+
+// ----------------------------------------------------------------------------
+// Doubleword Load/Store
+// ----------------------------------------------------------------------------
+
+handle_Ldrd: {
+    CHECK_COND();
+    // rn==15 (LDRD literal) arrives behind a PcSetup prefix with the
+    // alignment baked into the decoded offset
+    u32 addr = state_.regs[inst->ls.rn];
+    s32 offset = inst->ls.offset;
+    if (inst->ls.rm != 0xFF) {
+        offset = static_cast<s32>(state_.regs[inst->ls.rm]);
+        if (!(inst->ls.flags & 0x01)) {
+            offset = -offset; // U==0 => subtract register offset
+        }
+    }
+    u32 effective_addr;
+    switch (inst->ls.mode) {
+    case AddrMode::Offset:
+        effective_addr = addr + offset;
+        break;
+    case AddrMode::PreIndex:
+        effective_addr = addr + offset;
+        state_.regs[inst->ls.rn] = effective_addr;
+        break;
+    case AddrMode::PostIndex:
+        effective_addr = addr;
+        state_.regs[inst->ls.rn] = addr + offset;
+        break;
+    }
+    state_.regs[inst->rd] = MemRead32(effective_addr);
+    state_.regs[inst->ls.rt2] = MemRead32(effective_addr + 4);
+    executed += inst->ticks;
+    // If Rt2 == PC it's a branch (decode rejects this; kept for safety)
+    if (inst->ls.rt2 == 15) {
+        u32 new_pc = state_.regs[15];
+        state_.thumb_mode = new_pc & 1;
+        SET_PC(new_pc & ~1u);
+        goto chain;
+    }
+    SET_PC(GET_PC() + inst->inst_size);
+    DISPATCH();
+}
+
+handle_Strd: {
+    CHECK_COND();
+    u32 addr = state_.regs[inst->ls.rn];
+    s32 offset = inst->ls.offset;
+    if (inst->ls.rm != 0xFF) {
+        offset = static_cast<s32>(state_.regs[inst->ls.rm]);
+        if (!(inst->ls.flags & 0x01)) {
+            offset = -offset; // U==0 => subtract register offset
+        }
+    }
+    u32 effective_addr;
+    switch (inst->ls.mode) {
+    case AddrMode::Offset:
+        effective_addr = addr + offset;
+        break;
+    case AddrMode::PreIndex:
+        effective_addr = addr + offset;
+        state_.regs[inst->ls.rn] = effective_addr;
+        break;
+    case AddrMode::PostIndex:
+        effective_addr = addr;
+        state_.regs[inst->ls.rn] = addr + offset;
+        break;
+    }
+    MemWrite32(effective_addr, state_.regs[inst->rd]);
+    MemWrite32(effective_addr + 4, state_.regs[inst->ls.rt2]);
+    ADVANCE_AND_DISPATCH();
+}
+
+// ----------------------------------------------------------------------------
+// Load/Store Multiple
+// ----------------------------------------------------------------------------
+
+handle_Ldm: {
+    CHECK_COND();
+    u32 addr = state_.regs[inst->lsm.rn];
+    u16 reg_list = inst->lsm.reg_list;
+    bool writeback = (inst->lsm.flags & 0x01) != 0;  // W bit (bit 0)
+
+    // count/base_off/wb_delta precomputed at decode (fold increment/before)
+    u32 current = addr + inst->lsm.base_off;
+    u32 end_addr = current + inst->lsm.count * 4 - 4;
+
+    // Fast path: if all accesses are on the same mapped page, use direct pointer
+    // This avoids per-access null checks in the loop (critical for LDM performance)
+    const u8* base_page = local_page_ptrs[current >> FASTINTERP_PAGE_BITS];
+    bool same_page = (current >> FASTINTERP_PAGE_BITS) == (end_addr >> FASTINTERP_PAGE_BITS);
+
+    if (__builtin_expect(base_page != nullptr && same_page, 1)) {
+        // Fast path: direct pointer access without per-iteration checks
+        for (int i = 0; i < 16; i++) {
+            if (reg_list & (1 << i)) {
+                u32 loaded_val;
+                std::memcpy(&loaded_val, &base_page[current & FASTINTERP_PAGE_MASK], 4);
+                state_.regs[i] = loaded_val;
+                current += 4;
+            }
+        }
+    } else {
+        // Slow path: per-access checks (page boundary crossing or unmapped)
+        for (int i = 0; i < 16; i++) {
+            if (reg_list & (1 << i)) {
+                state_.regs[i] = MemRead32(current);
+                current += 4;
+            }
+        }
+    }
+
+    if (writeback) {
+        state_.regs[inst->lsm.rn] = addr + inst->lsm.wb_delta;
+    }
+
+    executed += inst->ticks;
+
+    // If PC was loaded, it's a branch - don't advance PC, end block
+    if (reg_list & (1 << 15)) {
+        // PC was loaded from memory - handle mode switch if needed
+        u32 new_pc = state_.regs[15];
+        state_.thumb_mode = new_pc & 1;
+        SET_PC(new_pc & ~1u);
+        goto chain;
+    }
+
+    SET_PC(GET_PC() + inst->inst_size);
+    DISPATCH();
+}
+
+handle_Stm: {
+    CHECK_COND();
+    u32 addr = state_.regs[inst->lsm.rn];
+    u16 reg_list = inst->lsm.reg_list;
+    bool writeback = (inst->lsm.flags & 0x01) != 0;  // W bit (bit 0)
+
+    // count/base_off/wb_delta precomputed at decode (fold increment/before)
+    u32 current = addr + inst->lsm.base_off;
+    u32 end_addr = current + inst->lsm.count * 4 - 4;
+
+    // Fast path: if all accesses are on the same mapped page, use direct pointer
+    u8* base_page = local_page_ptrs[current >> FASTINTERP_PAGE_BITS];
+    bool same_page = (current >> FASTINTERP_PAGE_BITS) == (end_addr >> FASTINTERP_PAGE_BITS);
+
+    if (__builtin_expect(base_page != nullptr && same_page, 1)) {
+        // Fast path: direct pointer access without per-iteration checks
+        for (int i = 0; i < 16; i++) {
+            if (reg_list & (1 << i)) {
+                u32 val = state_.regs[i];
+                std::memcpy(&base_page[current & FASTINTERP_PAGE_MASK], &val, 4);
+                current += 4;
+            }
+        }
+    } else {
+        // Slow path: per-access checks (page boundary crossing or unmapped)
+        for (int i = 0; i < 16; i++) {
+            if (reg_list & (1 << i)) {
+                MemWrite32(current, state_.regs[i]);
+                current += 4;
+            }
+        }
+    }
+
+    if (writeback) {
+        state_.regs[inst->lsm.rn] = addr + inst->lsm.wb_delta;
+    }
+
+    ADVANCE_AND_DISPATCH();
+}
diff --git a/src/core/arm/fastinterp/handlers/arm_misc.inc b/src/core/arm/fastinterp/handlers/arm_misc.inc
new file mode 100644
index 0000000..dbc5f04
--- /dev/null
+++ b/src/core/arm/fastinterp/handlers/arm_misc.inc
@@ -0,0 +1,981 @@
+// Copyright 2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// ARM Miscellaneous handlers: Clz, Swi, Mrs, Msr, sign/zero extend (Sxtb,
+//     Sxth, Uxtb, Uxth), byte reverse (Rev, Rev16, Revsh), saturating add/sub
+//     (Qadd, Qsub, Qdadd, Qdsub), Ssat, Usat, parallel add/sub (Sadd16..Uhsub8),
+//     extend-and-add (Sxtab, Sxtab16, Sxtah, Uxtab, Uxtab16, Uxtah), bitfield
+//     (Bfc, Bfi, Sbfx, Ubfx), Movt, Rbit, Pkhbt, Pkhtb, Sel, Usad8, Usada8,
+//     synchronization (Ldrex/Strex{,b,h,d}, Clrex), and coprocessor (Mrc, Mcr)
+
+handle_Clz: {
+    CHECK_COND();
+    u32 val = state_.regs[inst->dp.rm];
+    state_.regs[inst->rd] = val ? __builtin_clz(val) : 32;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Swi: {
+    CHECK_COND();
+    // Software interrupt - dispatch to kernel SVC handler
+    SET_PC(GET_PC() + inst->inst_size);
+    SYNC_PC();
+    {
+        u32 svc_num = inst->imm32 & 0xFF;
+        // Flush accumulated ticks to timer before kernel call so the
+        // kernel sees correct time state for scheduling decisions.
+        executed += inst->ticks;
+        timer->AddTicks(executed);
+        executed = 0;
+
+        svc_context_->CallSVC(svc_num);
+    }
+    // Kernel may have switched thread context via LoadContext,
+    // which changes state_.regs[15]. Reload local_pc and exit the
+    // block (context may have changed). Don't halt - PrepareReschedule
+    // will set halted_ if the kernel needs a reschedule.
+    local_pc = state_.regs[15];
+    goto done;
+}
+
+handle_Mrs: {
+    CHECK_COND();
+    state_.regs[inst->rd] = state_.GetCPSR();
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Msr: {
+    CHECK_COND();
+    u32 value = (inst->dp.rm != 0xFF) ? state_.regs[inst->dp.rm] : inst->dp.imm;
+    // Only update allowed fields (based on mask in flags)
+    u32 mask = 0;
+    if (inst->dp.flags & 0x01) mask |= 0x000000FF;  // Control
+    if (inst->dp.flags & 0x02) mask |= 0x0000FF00;  // Extension
+    if (inst->dp.flags & 0x04) mask |= 0x00FF0000;  // Status
+    if (inst->dp.flags & 0x08) mask |= 0xFF000000;  // Flags
+    state_.SetCPSR((state_.GetCPSR() & ~mask) | (value & mask));
+    ADVANCE_AND_DISPATCH();
+}
+
+// ----------------------------------------------------------------------------
+// Extension Instructions
+// ----------------------------------------------------------------------------
+
+handle_Sxtb: {
+    CHECK_COND();
+    u32 val = state_.regs[inst->dp.rm];
+    u8 rotation = inst->dp.shift_imm;
+    val = std::rotr(val, rotation);
+    state_.regs[inst->rd] = static_cast<u32>(static_cast<s8>(val));
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Sxth: {
+    CHECK_COND();
+    u32 val = state_.regs[inst->dp.rm];
+    u8 rotation = inst->dp.shift_imm;
+    val = std::rotr(val, rotation);
+    state_.regs[inst->rd] = static_cast<u32>(static_cast<s16>(val));
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Uxtb: {
+    CHECK_COND();
+    u32 val = state_.regs[inst->dp.rm];
+    u8 rotation = inst->dp.shift_imm;
+    val = std::rotr(val, rotation);
+    state_.regs[inst->rd] = val & 0xFF;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Uxth: {
+    CHECK_COND();
+    u32 val = state_.regs[inst->dp.rm];
+    u8 rotation = inst->dp.shift_imm;
+    val = std::rotr(val, rotation);
+    state_.regs[inst->rd] = val & 0xFFFF;
+    ADVANCE_AND_DISPATCH();
+}
+
+// ----------------------------------------------------------------------------
+// Byte Reversal
+// ----------------------------------------------------------------------------
+
+handle_Rev: {
+    CHECK_COND();
+    u32 val = state_.regs[inst->dp.rm];
+    state_.regs[inst->rd] = __builtin_bswap32(val);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Rev16: {
+    CHECK_COND();
+    u32 val = state_.regs[inst->dp.rm];
+    state_.regs[inst->rd] = ((val & 0xFF00FF00) >> 8) | ((val & 0x00FF00FF) << 8);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Revsh: {
+    CHECK_COND();
+    u32 val = state_.regs[inst->dp.rm];
+    u16 swapped = ((val & 0xFF) << 8) | ((val >> 8) & 0xFF);
+    state_.regs[inst->rd] = static_cast<u32>(static_cast<s16>(swapped));
+    ADVANCE_AND_DISPATCH();
+}
+
+// ----------------------------------------------------------------------------
+// Saturating Arithmetic
+// ----------------------------------------------------------------------------
+
+handle_Qadd: {
+    // QADD Rd, Rm, Rn - Signed saturating add
+    CHECK_COND();
+    s32 rm = static_cast<s32>(state_.regs[inst->dp.rm]);
+    s32 rn = static_cast<s32>(state_.regs[inst->dp.rn]);
+    s64 result = static_cast<s64>(rm) + static_cast<s64>(rn);
+    if (result > INT32_MAX) {
+        state_.regs[inst->rd] = INT32_MAX;
+        state_.cpsr_other |= (1 << 27);  // Set Q flag
+    } else if (result < INT32_MIN) {
+        state_.regs[inst->rd] = INT32_MIN;
+        state_.cpsr_other |= (1 << 27);  // Set Q flag
+    } else {
+        state_.regs[inst->rd] = static_cast<u32>(result);
+    }
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Qsub: {
+    // QSUB Rd, Rm, Rn - Signed saturating subtract
+    CHECK_COND();
+    s32 rm = static_cast<s32>(state_.regs[inst->dp.rm]);
+    s32 rn = static_cast<s32>(state_.regs[inst->dp.rn]);
+    s64 result = static_cast<s64>(rm) - static_cast<s64>(rn);
+    if (result > INT32_MAX) {
+        state_.regs[inst->rd] = INT32_MAX;
+        state_.cpsr_other |= (1 << 27);  // Set Q flag
+    } else if (result < INT32_MIN) {
+        state_.regs[inst->rd] = INT32_MIN;
+        state_.cpsr_other |= (1 << 27);  // Set Q flag
+    } else {
+        state_.regs[inst->rd] = static_cast<u32>(result);
+    }
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Qdadd: {
+    // QDADD Rd, Rm, Rn - Signed saturating double and add
+    // Rd = saturate(Rm + saturate(Rn * 2))
+    CHECK_COND();
+    s32 rm = static_cast<s32>(state_.regs[inst->dp.rm]);
+    s32 rn = static_cast<s32>(state_.regs[inst->dp.rn]);
+    // Double Rn with saturation
+    s64 doubled = static_cast<s64>(rn) * 2;
+    s32 sat_doubled;
+    if (doubled > INT32_MAX) {
+        sat_doubled = INT32_MAX;
+        state_.cpsr_other |= (1 << 27);
+    } else if (doubled < INT32_MIN) {
+        sat_doubled = INT32_MIN;
+        state_.cpsr_other |= (1 << 27);
+    } else {
+        sat_doubled = static_cast<s32>(doubled);
+    }
+    // Add with saturation
+    s64 result = static_cast<s64>(rm) + static_cast<s64>(sat_doubled);
+    if (result > INT32_MAX) {
+        state_.regs[inst->rd] = INT32_MAX;
+        state_.cpsr_other |= (1 << 27);
+    } else if (result < INT32_MIN) {
+        state_.regs[inst->rd] = INT32_MIN;
+        state_.cpsr_other |= (1 << 27);
+    } else {
+        state_.regs[inst->rd] = static_cast<u32>(result);
+    }
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Qdsub: {
+    // QDSUB Rd, Rm, Rn - Signed saturating double and subtract
+    // Rd = saturate(Rm - saturate(Rn * 2))
+    CHECK_COND();
+    s32 rm = static_cast<s32>(state_.regs[inst->dp.rm]);
+    s32 rn = static_cast<s32>(state_.regs[inst->dp.rn]);
+    // Double Rn with saturation
+    s64 doubled = static_cast<s64>(rn) * 2;
+    s32 sat_doubled;
+    if (doubled > INT32_MAX) {
+        sat_doubled = INT32_MAX;
+        state_.cpsr_other |= (1 << 27);
+    } else if (doubled < INT32_MIN) {
+        sat_doubled = INT32_MIN;
+        state_.cpsr_other |= (1 << 27);
+    } else {
+        sat_doubled = static_cast<s32>(doubled);
+    }
+    // Subtract with saturation
+    s64 result = static_cast<s64>(rm) - static_cast<s64>(sat_doubled);
+    if (result > INT32_MAX) {
+        state_.regs[inst->rd] = INT32_MAX;
+        state_.cpsr_other |= (1 << 27);
+    } else if (result < INT32_MIN) {
+        state_.regs[inst->rd] = INT32_MIN;
+        state_.cpsr_other |= (1 << 27);
+    } else {
+        state_.regs[inst->rd] = static_cast<u32>(result);
+    }
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Ssat: {
+    // SSAT Rd, #sat, Rm{, shift}
+    // Saturate signed value to sat bits (-2^(sat-1) to 2^(sat-1)-1)
+    CHECK_COND();
+    u32 rm_val = state_.regs[inst->dp.rm];
+    u32 shift_amt = inst->dp.shift_imm;
+    s32 shifted;
+    if (inst->dp.shift_type == ShiftType::ASR) {
+        // ASR #0 encodes ASR #32; >> 31 sign-fills identically without the
+        // undefined shift-by-32
+        if (shift_amt == 0) shift_amt = 31;
+        shifted = static_cast<s32>(rm_val) >> shift_amt;
+    } else {
+        // LSL
+        shifted = static_cast<s32>(rm_val << shift_amt);
+    }
+    u32 sat_bits = inst->dp.imm; // Already decoded as 1-32
+    // 64-bit bounds: sat_bits == 32 would overflow the 32-bit shift
+    s64 max_val = (s64(1) << (sat_bits - 1)) - 1;
+    s64 min_val = -(s64(1) << (sat_bits - 1));
+    if (shifted > max_val) {
+        state_.regs[inst->rd] = static_cast<u32>(max_val);
+        state_.cpsr_other |= (1 << 27);  // Q flag
+    } else if (shifted < min_val) {
+        state_.regs[inst->rd] = static_cast<u32>(min_val);
+        state_.cpsr_other |= (1 << 27);  // Q flag
+    } else {
+        state_.regs[inst->rd] = static_cast<u32>(shifted);
+    }
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Usat: {
+    // USAT Rd, #sat, Rm{, shift}
+    // Saturate to unsigned value to sat bits (0 to 2^sat-1)
+    CHECK_COND();
+    u32 rm_val = state_.regs[inst->dp.rm];
+    u32 shift_amt = inst->dp.shift_imm;
+    s32 shifted;
+    if (inst->dp.shift_type == ShiftType::ASR) {
+        // ASR #0 encodes ASR #32; >> 31 sign-fills identically without the
+        // undefined shift-by-32
+        if (shift_amt == 0) shift_amt = 31;
+        shifted = static_cast<s32>(rm_val) >> shift_amt;
+    } else {
+        // LSL
+        shifted = static_cast<s32>(rm_val << shift_amt);
+    }
+    u32 sat_bits = inst->dp.imm; // 0-31
+    u32 max_val = sat_bits == 0 ? 0 : ((1u << sat_bits) - 1);
+    if (shifted < 0) {
+        state_.regs[inst->rd] = 0;
+        state_.cpsr_other |= (1 << 27);  // Q flag
+    } else if (static_cast<u32>(shifted) > max_val) {
+        state_.regs[inst->rd] = max_val;
+        state_.cpsr_other |= (1 << 27);  // Q flag
+    } else {
+        state_.regs[inst->rd] = static_cast<u32>(shifted);
+    }
+    ADVANCE_AND_DISPATCH();
+}
+
+// ----------------------------------------------------------------------------
+// Parallel Add/Sub (set GE flags in CPSR[19:16])
+// ----------------------------------------------------------------------------
+
+// GE flag helpers: CPSR bits [19:16]
+#define SET_GE(val) (state_.cpsr_other = (state_.cpsr_other & ~0x000F0000u) | (((val) & 0xF) << 16))
+#define GET_GE() ((state_.cpsr_other >> 16) & 0xF)
+
+handle_Sadd16: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    s32 lo = static_cast<s16>(rn) + static_cast<s16>(rm);
+    s32 hi = static_cast<s16>(rn >> 16) + static_cast<s16>(rm >> 16);
+    state_.regs[inst->rd] = (static_cast<u32>(static_cast<u16>(lo))) |
+                            (static_cast<u32>(static_cast<u16>(hi)) << 16);
+    u32 ge = 0;
+    if (lo >= 0) ge |= 0x3;
+    if (hi >= 0) ge |= 0xC;
+    SET_GE(ge);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Ssub16: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    s32 lo = static_cast<s16>(rn) - static_cast<s16>(rm);
+    s32 hi = static_cast<s16>(rn >> 16) - static_cast<s16>(rm >> 16);
+    state_.regs[inst->rd] = (static_cast<u32>(static_cast<u16>(lo))) |
+                            (static_cast<u32>(static_cast<u16>(hi)) << 16);
+    u32 ge = 0;
+    if (lo >= 0) ge |= 0x3;
+    if (hi >= 0) ge |= 0xC;
+    SET_GE(ge);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Sadd8: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 result = 0;
+    u32 ge = 0;
+    for (int i = 0; i < 4; i++) {
+        s32 a = static_cast<s8>((rn >> (i * 8)) & 0xFF);
+        s32 b = static_cast<s8>((rm >> (i * 8)) & 0xFF);
+        s32 sum = a + b;
+        result |= (static_cast<u32>(static_cast<u8>(sum)) << (i * 8));
+        if (sum >= 0) ge |= (1u << i);
+    }
+    state_.regs[inst->rd] = result;
+    SET_GE(ge);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Ssub8: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 result = 0;
+    u32 ge = 0;
+    for (int i = 0; i < 4; i++) {
+        s32 a = static_cast<s8>((rn >> (i * 8)) & 0xFF);
+        s32 b = static_cast<s8>((rm >> (i * 8)) & 0xFF);
+        s32 diff = a - b;
+        result |= (static_cast<u32>(static_cast<u8>(diff)) << (i * 8));
+        if (diff >= 0) ge |= (1u << i);
+    }
+    state_.regs[inst->rd] = result;
+    SET_GE(ge);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Uadd16: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 lo = (rn & 0xFFFF) + (rm & 0xFFFF);
+    u32 hi = ((rn >> 16) & 0xFFFF) + ((rm >> 16) & 0xFFFF);
+    state_.regs[inst->rd] = (lo & 0xFFFF) | ((hi & 0xFFFF) << 16);
+    u32 ge = 0;
+    if (lo >= 0x10000) ge |= 0x3;
+    if (hi >= 0x10000) ge |= 0xC;
+    SET_GE(ge);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Usub16: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 rn_lo = rn & 0xFFFF, rm_lo = rm & 0xFFFF;
+    u32 rn_hi = (rn >> 16) & 0xFFFF, rm_hi = (rm >> 16) & 0xFFFF;
+    state_.regs[inst->rd] = ((rn_lo - rm_lo) & 0xFFFF) | (((rn_hi - rm_hi) & 0xFFFF) << 16);
+    u32 ge = 0;
+    if (rn_lo >= rm_lo) ge |= 0x3;
+    if (rn_hi >= rm_hi) ge |= 0xC;
+    SET_GE(ge);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Uadd8: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 result = 0;
+    u32 ge = 0;
+    for (int i = 0; i < 4; i++) {
+        u32 a = (rn >> (i * 8)) & 0xFF;
+        u32 b = (rm >> (i * 8)) & 0xFF;
+        u32 sum = a + b;
+        result |= ((sum & 0xFF) << (i * 8));
+        if (sum >= 0x100) ge |= (1u << i);
+    }
+    state_.regs[inst->rd] = result;
+    SET_GE(ge);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Usub8: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 result = 0;
+    u32 ge = 0;
+    for (int i = 0; i < 4; i++) {
+        u32 a = (rn >> (i * 8)) & 0xFF;
+        u32 b = (rm >> (i * 8)) & 0xFF;
+        result |= (((a - b) & 0xFF) << (i * 8));
+        if (a >= b) ge |= (1u << i);
+    }
+    state_.regs[inst->rd] = result;
+    SET_GE(ge);
+    ADVANCE_AND_DISPATCH();
+}
+
+// Unsigned saturating parallel operations
+handle_Uqadd16: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 lo = (rn & 0xFFFF) + (rm & 0xFFFF);
+    u32 hi = ((rn >> 16) & 0xFFFF) + ((rm >> 16) & 0xFFFF);
+    if (lo > 0xFFFF) lo = 0xFFFF;
+    if (hi > 0xFFFF) hi = 0xFFFF;
+    state_.regs[inst->rd] = (lo & 0xFFFF) | (hi << 16);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Uqsub16: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 lo_rn = rn & 0xFFFF, lo_rm = rm & 0xFFFF;
+    u32 hi_rn = (rn >> 16) & 0xFFFF, hi_rm = (rm >> 16) & 0xFFFF;
+    u32 lo = lo_rn > lo_rm ? lo_rn - lo_rm : 0;
+    u32 hi = hi_rn > hi_rm ? hi_rn - hi_rm : 0;
+    state_.regs[inst->rd] = (lo & 0xFFFF) | (hi << 16);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Uqadd8: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 result = 0;
+    for (int i = 0; i < 4; i++) {
+        u32 a = (rn >> (i * 8)) & 0xFF;
+        u32 b = (rm >> (i * 8)) & 0xFF;
+        u32 sum = a + b;
+        if (sum > 0xFF) sum = 0xFF;
+        result |= (sum << (i * 8));
+    }
+    state_.regs[inst->rd] = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Uqsub8: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 result = 0;
+    for (int i = 0; i < 4; i++) {
+        u32 a = (rn >> (i * 8)) & 0xFF;
+        u32 b = (rm >> (i * 8)) & 0xFF;
+        u32 diff = a > b ? a - b : 0;
+        result |= (diff << (i * 8));
+    }
+    state_.regs[inst->rd] = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+// Signed saturating parallel operations
+handle_Qadd16: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    s32 lo = static_cast<s16>(rn) + static_cast<s16>(rm);
+    s32 hi = static_cast<s16>(rn >> 16) + static_cast<s16>(rm >> 16);
+    if (lo > 32767) lo = 32767; else if (lo < -32768) lo = -32768;
+    if (hi > 32767) hi = 32767; else if (hi < -32768) hi = -32768;
+    state_.regs[inst->rd] = (static_cast<u32>(static_cast<u16>(lo))) |
+                            (static_cast<u32>(static_cast<u16>(hi)) << 16);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Qsub16: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    s32 lo = static_cast<s16>(rn) - static_cast<s16>(rm);
+    s32 hi = static_cast<s16>(rn >> 16) - static_cast<s16>(rm >> 16);
+    if (lo > 32767) lo = 32767; else if (lo < -32768) lo = -32768;
+    if (hi > 32767) hi = 32767; else if (hi < -32768) hi = -32768;
+    state_.regs[inst->rd] = (static_cast<u32>(static_cast<u16>(lo))) |
+                            (static_cast<u32>(static_cast<u16>(hi)) << 16);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Qadd8: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 result = 0;
+    for (int i = 0; i < 4; i++) {
+        s32 a = static_cast<s8>((rn >> (i * 8)) & 0xFF);
+        s32 b = static_cast<s8>((rm >> (i * 8)) & 0xFF);
+        s32 sum = a + b;
+        if (sum > 127) sum = 127; else if (sum < -128) sum = -128;
+        result |= (static_cast<u32>(static_cast<u8>(sum)) << (i * 8));
+    }
+    state_.regs[inst->rd] = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Qsub8: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 result = 0;
+    for (int i = 0; i < 4; i++) {
+        s32 a = static_cast<s8>((rn >> (i * 8)) & 0xFF);
+        s32 b = static_cast<s8>((rm >> (i * 8)) & 0xFF);
+        s32 diff = a - b;
+        if (diff > 127) diff = 127; else if (diff < -128) diff = -128;
+        result |= (static_cast<u32>(static_cast<u8>(diff)) << (i * 8));
+    }
+    state_.regs[inst->rd] = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+// Signed halving parallel operations
+handle_Shadd16: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    s32 lo = (static_cast<s16>(rn) + static_cast<s16>(rm)) >> 1;
+    s32 hi = (static_cast<s16>(rn >> 16) + static_cast<s16>(rm >> 16)) >> 1;
+    state_.regs[inst->rd] = (static_cast<u32>(static_cast<u16>(lo))) |
+                            (static_cast<u32>(static_cast<u16>(hi)) << 16);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Shsub16: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    s32 lo = (static_cast<s16>(rn) - static_cast<s16>(rm)) >> 1;
+    s32 hi = (static_cast<s16>(rn >> 16) - static_cast<s16>(rm >> 16)) >> 1;
+    state_.regs[inst->rd] = (static_cast<u32>(static_cast<u16>(lo))) |
+                            (static_cast<u32>(static_cast<u16>(hi)) << 16);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Shadd8: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 result = 0;
+    for (int i = 0; i < 4; i++) {
+        s32 a = static_cast<s8>((rn >> (i * 8)) & 0xFF);
+        s32 b = static_cast<s8>((rm >> (i * 8)) & 0xFF);
+        result |= (static_cast<u32>(static_cast<u8>((a + b) >> 1)) << (i * 8));
+    }
+    state_.regs[inst->rd] = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Shsub8: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 result = 0;
+    for (int i = 0; i < 4; i++) {
+        s32 a = static_cast<s8>((rn >> (i * 8)) & 0xFF);
+        s32 b = static_cast<s8>((rm >> (i * 8)) & 0xFF);
+        result |= (static_cast<u32>(static_cast<u8>((a - b) >> 1)) << (i * 8));
+    }
+    state_.regs[inst->rd] = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+// Unsigned halving parallel operations
+handle_Uhadd16: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 lo = ((rn & 0xFFFF) + (rm & 0xFFFF)) >> 1;
+    u32 hi = (((rn >> 16) & 0xFFFF) + ((rm >> 16) & 0xFFFF)) >> 1;
+    state_.regs[inst->rd] = (lo & 0xFFFF) | (hi << 16);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Uhsub16: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 lo = ((rn & 0xFFFF) - (rm & 0xFFFF)) >> 1;
+    u32 hi = (((rn >> 16) & 0xFFFF) - ((rm >> 16) & 0xFFFF)) >> 1;
+    state_.regs[inst->rd] = (lo & 0xFFFF) | (hi << 16);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Uhadd8: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 result = 0;
+    for (int i = 0; i < 4; i++) {
+        u32 a = (rn >> (i * 8)) & 0xFF;
+        u32 b = (rm >> (i * 8)) & 0xFF;
+        result |= (((a + b) >> 1) << (i * 8));
+    }
+    state_.regs[inst->rd] = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Uhsub8: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 result = 0;
+    for (int i = 0; i < 4; i++) {
+        u32 a = (rn >> (i * 8)) & 0xFF;
+        u32 b = (rm >> (i * 8)) & 0xFF;
+        result |= (((a - b) >> 1) << (i * 8));
+    }
+    state_.regs[inst->rd] = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+// Extend with Add operations
+handle_Sxtab: {
+    CHECK_COND();
+    u32 rm_val = state_.regs[inst->dp.rm];
+    u32 rotated = std::rotr(rm_val, inst->dp.shift_imm);
+    s32 extended = static_cast<s8>(rotated & 0xFF);
+    state_.regs[inst->rd] = state_.regs[inst->dp.rn] + static_cast<u32>(extended);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Sxtab16: {
+    CHECK_COND();
+    u32 rm_val = state_.regs[inst->dp.rm];
+    u32 rotated = std::rotr(rm_val, inst->dp.shift_imm);
+    // Rn=15 encodes SXTB16 (no add)
+    u32 rn_val = (inst->dp.rn == 15) ? 0 : state_.regs[inst->dp.rn];
+    u32 lo = (rn_val & 0xFFFF) + static_cast<u32>(static_cast<u16>(static_cast<s16>(static_cast<s8>(rotated & 0xFF))));
+    u32 hi = ((rn_val >> 16) & 0xFFFF) + static_cast<u32>(static_cast<u16>(static_cast<s16>(static_cast<s8>((rotated >> 16) & 0xFF))));
+    state_.regs[inst->rd] = (lo & 0xFFFF) | (hi << 16);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Sxtah: {
+    CHECK_COND();
+    u32 rm_val = state_.regs[inst->dp.rm];
+    u32 rotated = std::rotr(rm_val, inst->dp.shift_imm);
+    s32 extended = static_cast<s16>(rotated & 0xFFFF);
+    state_.regs[inst->rd] = state_.regs[inst->dp.rn] + static_cast<u32>(extended);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Uxtab: {
+    CHECK_COND();
+    u32 rm_val = state_.regs[inst->dp.rm];
+    u32 rotated = std::rotr(rm_val, inst->dp.shift_imm);
+    state_.regs[inst->rd] = state_.regs[inst->dp.rn] + (rotated & 0xFF);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Uxtab16: {
+    CHECK_COND();
+    u32 rm_val = state_.regs[inst->dp.rm];
+    u32 rotated = std::rotr(rm_val, inst->dp.shift_imm);
+    // Rn=15 encodes UXTB16 (no add)
+    u32 rn_val = (inst->dp.rn == 15) ? 0 : state_.regs[inst->dp.rn];
+    u32 lo = (rn_val & 0xFFFF) + (rotated & 0xFF);
+    u32 hi = ((rn_val >> 16) & 0xFFFF) + ((rotated >> 16) & 0xFF);
+    state_.regs[inst->rd] = (lo & 0xFFFF) | (hi << 16);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Uxtah: {
+    CHECK_COND();
+    u32 rm_val = state_.regs[inst->dp.rm];
+    u32 rotated = std::rotr(rm_val, inst->dp.shift_imm);
+    state_.regs[inst->rd] = state_.regs[inst->dp.rn] + (rotated & 0xFFFF);
+    ADVANCE_AND_DISPATCH();
+}
+
+// Bit field operations
+handle_Bfc: {
+    CHECK_COND();
+    u32 lsb = inst->dp.imm;
+    u32 width = inst->dp.shift_imm;
+    // width is 1-32: shift the all-ones mask down instead of 1<<32
+    u32 mask = (0xFFFFFFFFu >> (32 - width)) << lsb;
+    state_.regs[inst->rd] &= ~mask;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Bfi: {
+    CHECK_COND();
+    u32 lsb = inst->dp.imm;
+    u32 width = inst->dp.shift_imm;
+    u32 mask = (0xFFFFFFFFu >> (32 - width)) << lsb;
+    u32 src = state_.regs[inst->dp.rn];
+    state_.regs[inst->rd] = (state_.regs[inst->rd] & ~mask) | ((src << lsb) & mask);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Sbfx: {
+    CHECK_COND();
+    u32 lsb = inst->dp.imm;
+    u32 width = inst->dp.shift_imm;
+    u32 src = state_.regs[inst->dp.rn];
+    u32 mask = 0xFFFFFFFFu >> (32 - width); // width is 1-32
+    u32 field = (src >> lsb) & mask;
+    // Sign extend
+    if (field & (1u << (width - 1))) {
+        field |= ~mask;
+    }
+    state_.regs[inst->rd] = field;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Ubfx: {
+    CHECK_COND();
+    u32 lsb = inst->dp.imm;
+    u32 width = inst->dp.shift_imm;
+    u32 src = state_.regs[inst->dp.rn];
+    state_.regs[inst->rd] = (src >> lsb) & (0xFFFFFFFFu >> (32 - width));
+    ADVANCE_AND_DISPATCH();
+}
+
+// MOVT - Move Top (set upper 16 bits, preserve lower 16)
+handle_Movt: {
+    CHECK_COND();
+    u32 imm16 = inst->dp.imm;
+    state_.regs[inst->rd] = (state_.regs[inst->rd] & 0xFFFF) | (imm16 << 16);
+    ADVANCE_AND_DISPATCH();
+}
+
+// RBIT - Reverse bits
+handle_Rbit: {
+    CHECK_COND();
+    u32 val = state_.regs[inst->dp.rm];
+    val = ((val & 0x55555555) << 1) | ((val & 0xAAAAAAAA) >> 1);
+    val = ((val & 0x33333333) << 2) | ((val & 0xCCCCCCCC) >> 2);
+    val = ((val & 0x0F0F0F0F) << 4) | ((val & 0xF0F0F0F0) >> 4);
+    val = ((val & 0x00FF00FF) << 8) | ((val & 0xFF00FF00) >> 8);
+    val = (val << 16) | (val >> 16);
+    state_.regs[inst->rd] = val;
+    ADVANCE_AND_DISPATCH();
+}
+
+// ----------------------------------------------------------------------------
+// SIMD/Packed
+// ----------------------------------------------------------------------------
+
+handle_Pkhbt: {
+    // PKHBT Rd, Rn, Rm{, LSL #imm}
+    // Rd[15:0] = Rn[15:0], Rd[31:16] = (Rm << shift)[31:16]
+    CHECK_COND();
+    u32 rn_val = state_.regs[inst->dp.rn];
+    u32 rm_val = state_.regs[inst->dp.rm];
+    u32 shifted = rm_val << inst->dp.shift_imm;
+    state_.regs[inst->rd] = (rn_val & 0xFFFF) | (shifted & 0xFFFF0000);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Pkhtb: {
+    // PKHTB Rd, Rn, Rm{, ASR #imm}
+    // Rd[31:16] = Rn[31:16], Rd[15:0] = (Rm >> shift)[15:0] (arithmetic shift)
+    CHECK_COND();
+    u32 rn_val = state_.regs[inst->dp.rn];
+    u32 rm_val = state_.regs[inst->dp.rm];
+    // ASR #0 encodes ASR #32; >> 31 sign-fills identically without the
+    // undefined shift-by-32
+    u32 shift = inst->dp.shift_imm == 0 ? 31 : inst->dp.shift_imm;
+    s32 shifted = static_cast<s32>(rm_val) >> shift;
+    state_.regs[inst->rd] = (rn_val & 0xFFFF0000) | (static_cast<u32>(shifted) & 0xFFFF);
+    ADVANCE_AND_DISPATCH();
+}
+
+// SEL: select bytes based on GE flags
+handle_Sel: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 ge = GET_GE();
+    u32 result = 0;
+    for (int i = 0; i < 4; i++) {
+        u32 mask = 0xFFu << (i * 8);
+        result |= (ge & (1u << i)) ? (rn & mask) : (rm & mask);
+    }
+    state_.regs[inst->rd] = result;
+    ADVANCE_AND_DISPATCH();
+}
+
+// USAD8: unsigned sum of absolute differences
+handle_Usad8: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 sum = 0;
+    for (int i = 0; i < 4; i++) {
+        s32 a = (rn >> (i * 8)) & 0xFF;
+        s32 b = (rm >> (i * 8)) & 0xFF;
+        sum += static_cast<u32>(a > b ? a - b : b - a);
+    }
+    state_.regs[inst->rd] = sum;
+    ADVANCE_AND_DISPATCH();
+}
+
+// USADA8: unsigned sum of absolute differences with accumulate
+handle_Usada8: {
+    CHECK_COND();
+    u32 rn = state_.regs[inst->dp.rn];
+    u32 rm = state_.regs[inst->dp.rm];
+    u32 sum = 0;
+    for (int i = 0; i < 4; i++) {
+        s32 a = (rn >> (i * 8)) & 0xFF;
+        s32 b = (rm >> (i * 8)) & 0xFF;
+        sum += static_cast<u32>(a > b ? a - b : b - a);
+    }
+    state_.regs[inst->rd] = state_.regs[inst->dp.imm] + sum;
+    ADVANCE_AND_DISPATCH();
+}
+
+// ----------------------------------------------------------------------------
+// Exclusive Load/Store
+// ----------------------------------------------------------------------------
+
+// LDREX reserves a value at an address; STREX succeeds only if the reserved
+// word is still there (AtomicCompareAndSwap), which is what enforces
+// exclusivity against other cores and the DSP host thread. The mapped-RAM path
+// reads and swaps through the page table inline; MMIO / rasterizer-cached pages
+// (null in the page array) fall back to the MemorySystem slow path.
+#define EXCLUSIVE_LOAD(bits, memtype, memread)                                                      \
+    CHECK_COND();                                                                                   \
+    const u32 addr = state_.regs[inst->dp.rn];                                                      \
+    memtype value;                                                                                  \
+    if (u8* page = local_page_ptrs[addr >> FASTINTERP_PAGE_BITS]) {                                 \
+        std::memcpy(&value, &page[addr & FASTINTERP_PAGE_MASK], sizeof(memtype));                   \
+    } else {                                                                                        \
+        value = memory_.memread(addr);                                                              \
+    }                                                                                               \
+    exclusive_.addr = addr;                                                                         \
+    exclusive_.value = value;                                                                       \
+    exclusive_.size = bits / 8;                                                                     \
+    exclusive_.valid = true;
+
+#define EXCLUSIVE_STORE(bits, memtype, memwrite, srcval)                                            \
+    CHECK_COND();                                                                                   \
+    const u32 addr = state_.regs[inst->dp.rn];                                                      \
+    bool ok = false;                                                                                \
+    if (exclusive_.valid && exclusive_.addr == addr && exclusive_.size == bits / 8) {               \
+        const memtype expected = static_cast<memtype>(exclusive_.value);                            \
+        if (u8* page = local_page_ptrs[addr >> FASTINTERP_PAGE_BITS]) {                             \
+            ok = Common::AtomicCompareAndSwap(                                                      \
+                reinterpret_cast<volatile memtype*>(&page[addr & FASTINTERP_PAGE_MASK]), (srcval),  \
+                expected);                                                                          \
+        } else {                                                                                    \
+            ok = memory_.memwrite(addr, (srcval), expected);                                        \
+        }                                                                                           \
+    }                                                                                               \
+    exclusive_.valid = false;                                                                       \
+    state_.regs[inst->rd] = ok ? 0 : 1;
+
+handle_Ldrex: {
+    EXCLUSIVE_LOAD(32, u32, Read32);
+    state_.regs[inst->rd] = value;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Strex: {
+    EXCLUSIVE_STORE(32, u32, WriteExclusive32, state_.regs[inst->dp.rm]);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Ldrexb: {
+    EXCLUSIVE_LOAD(8, u8, Read8);
+    state_.regs[inst->rd] = value;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Strexb: {
+    EXCLUSIVE_STORE(8, u8, WriteExclusive8, static_cast<u8>(state_.regs[inst->dp.rm]));
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Ldrexh: {
+    EXCLUSIVE_LOAD(16, u16, Read16);
+    state_.regs[inst->rd] = value;
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Strexh: {
+    EXCLUSIVE_STORE(16, u16, WriteExclusive16, static_cast<u16>(state_.regs[inst->dp.rm]));
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Ldrexd: {
+    EXCLUSIVE_LOAD(64, u64, Read64);
+    state_.regs[inst->rd] = static_cast<u32>(value);
+    state_.regs[inst->rd + 1] = static_cast<u32>(value >> 32);
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Strexd: {
+    const u64 dval = static_cast<u64>(state_.regs[inst->dp.rm]) |
+                     (static_cast<u64>(state_.regs[inst->dp.rm + 1]) << 32);
+    EXCLUSIVE_STORE(64, u64, WriteExclusive64, dval);
+    ADVANCE_AND_DISPATCH();
+}
+
+#undef EXCLUSIVE_LOAD
+#undef EXCLUSIVE_STORE
+
+handle_Clrex:
+    exclusive_.valid = false;
+    ADVANCE_AND_DISPATCH();
+
+// ----------------------------------------------------------------------------
+// Coprocessor (CP15) Instructions
+// ----------------------------------------------------------------------------
+
+handle_Mrc: {
+    // MRC p15, opc1, Rt, CRn, CRm, opc2
+    CHECK_COND();
+    u32 crn = inst->dp.rn;       // CRn
+    u32 crm = inst->dp.rm;       // CRm
+    u32 opc1 = inst->dp.shift_imm; // opc1
+    u32 opc2 = inst->dp.imm;     // opc2
+    u32 value = 0;
+
+    if (crn == 13 && opc1 == 0 && crm == 0) {
+        if (opc2 == 2) value = state_.cp15_thread_uprw;
+        else if (opc2 == 3) value = state_.cp15_thread_uro;
+    }
+
+    if (inst->rd == 15) {
+        // Write to CPSR flags
+        u32 cpsr = state_.GetCPSR();
+        cpsr = (cpsr & ~0xF0000000u) | (value & 0xF0000000u);
+        state_.SetCPSR(cpsr);
+    } else {
+        state_.regs[inst->rd] = value;
+    }
+    ADVANCE_AND_DISPATCH();
+}
+
+handle_Mcr: {
+    // MCR p15, opc1, Rt, CRn, CRm, opc2
+    CHECK_COND();
+    u32 crn = inst->dp.rn;
+    u32 crm = inst->dp.rm;
+    u32 opc1 = inst->dp.shift_imm;
+    u32 opc2 = inst->dp.imm;
+    u32 value = state_.regs[inst->rd];
+
+    if (crn == 13 && opc1 == 0 && crm == 0) {
+        if (opc2 == 2) state_.cp15_thread_uprw = value;
+        else if (opc2 == 3) state_.cp15_thread_uro = value;
+    }
+    ADVANCE_AND_DISPATCH();
+}
