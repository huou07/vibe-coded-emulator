+        HANDLER(ThumbStmia),
+        HANDLER(ThumbBCond),
+        HANDLER(ThumbB),
+        HANDLER(ThumbSwi),
+        HANDLER(ThumbSxth),
+        HANDLER(ThumbSxtb),
+        HANDLER(ThumbUxth),
+        HANDLER(ThumbUxtb),
+        HANDLER(ThumbRev),
+        HANDLER(ThumbRev16),
+        HANDLER(ThumbRevsh),
