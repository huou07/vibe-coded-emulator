diff --git a/src/citra_libretro/citra_libretro.cpp b/src/citra_libretro/citra_libretro.cpp
index d7ef6e9..0d75247 100644
--- a/src/citra_libretro/citra_libretro.cpp
+++ b/src/citra_libretro/citra_libretro.cpp
@@ -238,6 +238,33 @@ static void UpdateSettings() {
 /**
  * libretro callback; Called every game tick.
  */
+#ifdef __EMSCRIPTEN__
+/// Pace the emulated machine to the 3DS LCD rate.
+///
+/// The EmulatorJS runtime runs a threaded core on a pthread main loop and leaves
+/// it unpaced unless the user turns VSync on, so the achieved frame rate is
+/// whatever the host CPU happens to afford: DynCom managed ~0.7x of real time and
+/// FastInterp ~1.9x on the same machine. Both are wrong speeds. Waiting here only
+/// when the core is *ahead* of the LCD restores real-time play without adding a
+/// stall when the hardware cannot keep up, and it does not depend on the display
+/// refresh rate the frontend happens to report.
+static void LimitFrameRateToLcd() {
+    using Clock = std::chrono::steady_clock;
+    static Clock::time_point next{};
+    constexpr auto period = std::chrono::duration_cast<Clock::duration>(
+        std::chrono::duration<double>(1.0 / 59.8261));
+    const auto now = Clock::now();
+    if (next.time_since_epoch().count() == 0 || now > next + period) {
+        // First frame, or the core fell behind: restart the schedule from now so
+        // a slow frame never triggers a catch-up burst of unthrottled frames.
+        next = now + period;
+        return;
+    }
+    std::this_thread::sleep_until(next);
+    next += period;
+}
+#endif
+
 void retro_run() {
     if (!emu_instance || !emu_instance->game_loaded) {
         return;
@@ -318,6 +345,10 @@ void retro_run() {
             LibRetro::DisplayMessage(msg.c_str());
         }
     }
+
+#ifdef __EMSCRIPTEN__
+    LimitFrameRateToLcd();
+#endif
 }
 
