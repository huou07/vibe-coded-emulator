# Example reverse-proxy configuration for Vibe Coded Emulator.
#
# This is a generic example. Replace the placeholder values with your own
# before deploying; the project ships no production domain or address.
{
    # ACME/Let's Encrypt contact address. Use an address you control.
    email YOUR_EMAIL@example.com
    http_port 8088
}

# Your public hostname(s). Replace example.com.
example.com, www.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8091
    header {
        -Server
    }
}
