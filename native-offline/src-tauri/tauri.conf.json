{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeCodedEmulator",
  "version": "2.3.0",
  "identifier": "space.an3tocom.offline",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VibeCodedEmulator",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin",
        "X-Content-Type-Options": "nosniff"
      },
      "csp": "default-src 'self' asset: blob: data:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob:; connect-src 'self' asset: blob:; worker-src 'self' blob:; media-src 'self' asset: blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/an3-roms/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "shortDescription": "A native local-ROM offline player",
    "longDescription": "VibeCodedEmulator plays ROMs selected by the user on the same device. It contains no online game library, dashboard, or account experience.",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/space.an3tocom.offline.metainfo.xml": "../flatpak/space.an3tocom.offline.metainfo.xml"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.4",
      "signingIdentity": "-",
      "entitlements": "native-staging.entitlements"
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../LICENSE": "LICENSE"
    }
  }
}
