{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Offline local-ROM player window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-pick-and-import-native-rom",
    "allow-remove-native-rom",
    "allow-native-capabilities",
    "allow-start-native-game",
    "allow-stop-native-game",
    "allow-set-native-input",
    "allow-native-controller-start",
    "allow-native-controller-stop",
    "allow-native-controller-status",
    "allow-native-controller-lan-start",
    "allow-native-controller-lan-join",
    "allow-native-controller-lan-send",
    "allow-native-controller-lan-stop",
    "allow-native-controller-lan-status",
    "allow-native-controller-lan-refresh",
    "allow-native-latency-start",
    "allow-native-latency-snapshot",
    "allow-native-latency-stop",
    "allow-native-sync-start",
    "allow-native-sync-join",
    "allow-native-sync-status",
    "allow-native-sync-stop",
    "allow-native-sync-discover",
    "allow-native-sync-forget",
    "allow-native-sync-request",
    "allow-native-sync-identity",
    "allow-native-sync-account-context",
    "allow-native-sync-set-account-proof",
    "allow-native-sync-mark-account-verified",
    "allow-native-sync-game-identity",
    "allow-native-sync-storage-read",
    "allow-native-sync-storage-write",
    "allow-native-sync-library-manifest",
    "allow-native-sync-library-read-chunk",
    "allow-native-sync-library-upload-status",
    "allow-native-sync-library-write-chunk",
    "allow-native-sync",
    "allow-switch-companion-detect",
    "allow-switch-companion-launch",
    "allow-switch-companion-launch-rom",
    "allow-switch-companion-hosted-frame-supported",
    "allow-switch-companion-status",
    "allow-switch-companion-stop",
    "allow-switch-companion-focus",
    "allow-switch-companion-input",
    "allow-switch-companion-analog",
    "allow-switch-companion-audio",
    "allow-switch-companion-hosted-frame",
    "allow-switch-companion-hosted-frame-start",
    "allow-switch-companion-hosted-frame-stop",
    "allow-switch-companion-hosted-frame-stats",
    "allow-switch-companion-hosted-frame-verify",
    "allow-ui-control-result"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:38471/*"
    ]
  }
}
